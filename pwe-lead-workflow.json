      "parameters": {
        "fromEmail": "={{ $('Config').item.json.fromName }} <{{ $('Config').item.json.fromEmail }}>",
        "toEmail": "={{ $('Webhook').item.json.body.email }}",
        "subject": "={{ $('Config').item.json.t_subject }}",
        "emailFormat": "html",
        "html": "=<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='background:#e9e9e7;padding:24px 12px;'><tr><td align='center'><table role='presentation' width='600' cellpadding='0' cellspacing='0' border='0' style='max-width:600px;width:100%;background:#ffffff;font-family:Archivo,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;'><tr><td style='background:#14181f;padding:26px 32px;'><table role='presentation' cellpadding='0' cellspacing='0' border='0'><tr><td style='width:44px;height:44px;background:#ffffff;text-align:center;vertical-align:middle;color:#14181f;font-weight:900;font-size:14px;'>PWE</td><td style='padding-left:12px;vertical-align:middle;'><div style='color:#ffffff;font-size:16px;font-weight:900;line-height:1.1;letter-spacing:-.02em;'>Panamá Worldwide Express</div><div style='color:#e11d2e;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.2em;margin-top:3px;'>{{ $('Config').item.json.t_kicker }}</div></td></tr></table></td></tr><tr><td style='padding:30px 32px 10px;'><p style='margin:0 0 10px;color:#14181f;font-size:22px;font-weight:900;letter-spacing:-.02em;'>{{ $('Config').item.json.t_greeting }} {{ $('Webhook').item.json.body.Nombre }},</p><p style='margin:0;color:#3f444c;font-size:15px;line-height:1.65;'>{{ $('Config').item.json.t_intro }}</p></td></tr><tr><td style='padding:18px 32px 6px;'><p style='margin:0 0 8px;color:#565a61;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.12em;'>{{ $('Config').item.json.t_summary }}</p><table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='font-size:14px;color:#14181f;background:#f6f6f5;border:1px solid #e9e9e7;'><tr><td style='padding:11px 16px;border-bottom:1px solid #e9e9e7;color:#565a61;width:145px;'>{{ $('Config').item.json.t_type }}</td><td style='padding:11px 16px;border-bottom:1px solid #e9e9e7;font-weight:700;'>{{ $('Webhook').item.json.body['Tipo de Mudanza'] }}</td></tr><tr><td style='padding:11px 16px;border-bottom:1px solid #e9e9e7;color:#565a61;'>{{ $('Config').item.json.t_from }}</td><td style='padding:11px 16px;border-bottom:1px solid #e9e9e7;font-weight:700;'>{{ $('Webhook').item.json.body.Origen }}</td></tr><tr><td style='padding:11px 16px;border-bottom:1px solid #e9e9e7;color:#565a61;'>{{ $('Config').item.json.t_to }}</td><td style='padding:11px 16px;border-bottom:1px solid #e9e9e7;font-weight:700;'>{{ $('Webhook').item.json.body.Destino }}</td></tr><tr><td style='padding:11px 16px;color:#565a61;'>{{ $('Config').item.json.t_date }}</td><td style='padding:11px 16px;font-weight:700;'>{{ $('Webhook').item.json.body['Fecha aproximada'] }}</td></tr></table></td></tr><tr><td style='padding:22px 32px 6px;' align='center'><a href='{{ $('Config').item.json.whatsappUrl }}' style='display:inline-block;background:#e11d2e;color:#ffffff;font-weight:800;font-size:14px;text-decoration:none;padding:14px 28px;text-transform:uppercase;letter-spacing:.04em;'>{{ $('Config').item.json.t_urgent }}</a></td></tr><tr><td style='padding:16px 32px 26px;'><p style='margin:0;color:#3f444c;font-size:14px;line-height:1.6;'>{{ $('Config').item.json.t_signoff }}<br /><b style='color:#14181f;'>Panamá Worldwide Express</b><br /><span style='color:#565a61;'>{{ $('Config').item.json.phone }} · <a href='mailto:{{ $('Config').item.json.businessEmail }}' style='color:#b5121f;font-weight:700;text-decoration:none;'>{{ $('Config').item.json.businessEmail }}</a></span></p></td></tr><tr><td style='background:#14181f;padding:16px 32px;text-align:center;'><span style='color:#7d7f83;font-size:11px;'>{{ $('Config').item.json.t_footer }} {{ $('Config').item.json.siteDomain }}</span></td></tr></table></td></tr></table>",
        "options": {
          "appendAttribution": false,
          "replyTo": "={{ $('Config').item.json.businessEmail }}"
        }
      },
      "credentials": {
        "smtp": { "id": "brevosmtp0001", "name": "SMTP Brevo" }
      }
    },
    {
      "id": "b1c2d3e4-0006-4000-8000-000000000006",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1400, 300],
      "notes": "Los bots también reciben success:true. No les damos señal de que fueron filtrados.",
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"success\": true}",
        "options": { "responseHeaders": { "entries": [{ "name": "Access-Control-Allow-Origin", "value": "*" }] } }
      }
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
    "Config": { "main": [[{ "node": "¿Humano?", "type": "main", "index": 0 }]] },
    "¿Humano?": {
      "main": [
        [{ "node": "Aviso interno", "type": "main", "index": 0 }],
        [{ "node": "Respond", "type": "main", "index": 0 }]
      ]
    },
    "Aviso interno": { "main": [[{ "node": "Autorespuesta al cliente", "type": "main", "index": 0 }]] },
    "Autorespuesta al cliente": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
