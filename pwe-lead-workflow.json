    {
      "id": "b1c2d3e4-0003-4000-8000-000000000003",
      "name": "¿Humano?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [680, 300],
      "notes": "El formulario trae un campo trampa 'botcheck' oculto. Un humano nunca lo llena; los bots sí. Si viene con algo, se descarta en silencio.",
      "parameters": {
        "options": {},
        "conditions": {
          "combinator": "and",
          "options": {
            "version": 2,
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "hp-01",
              "leftValue": "={{ $json.body.botcheck }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              }
            }
          ]
        }
      }
    },
    {
      "id": "b1c2d3e4-0004-4000-8000-000000000004",
      "name": "Aviso interno",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [920, 180],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "notes": "Si esto falla, el visitante ve error y puede reintentar. Falla ruidosa a propósito: perder un lead en silencio es peor.",
      "parameters": {
        "fromEmail": "={{ $('Config').item.json.fromName }} <{{ $('Config').item.json.fromEmail }}>",
        "toEmail": "={{ $('Config').item.json.toEmail }}",
        "subject": "=Nueva cotización PWE — {{ $json.body.Nombre }} ({{ $json.body['Tipo de Mudanza'] }})",
        "emailFormat": "html",
        "html": "=<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='background:#e9e9e7;padding:24px 12px;'><tr><td align='center'><table role='presentation' width='600' cellpadding='0' cellspacing='0' border='0' style='max-width:600px;width:100%;background:#ffffff;font-family:Archivo,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;'><tr><td style='background:#14181f;padding:26px 32px;'><table role='presentation' cellpadding='0' cellspacing='0' border='0'><tr><td style='width:44px;height:44px;background:#ffffff;text-align:center;vertical-align:middle;color:#14181f;font-weight:900;font-size:14px;'>PWE</td><td style='padding-left:12px;vertical-align:middle;'><div style='color:#ffffff;font-size:16px;font-weight:900;line-height:1.1;letter-spacing:-.02em;'>Panamá Worldwide Express</div><div style='color:#e11d2e;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.2em;margin-top:3px;'>Nueva solicitud de cotización</div></td></tr></table></td></tr><tr><td style='padding:28px 32px 8px;'><p style='margin:0 0 4px;color:#14181f;font-size:20px;font-weight:900;'>{{ $json.body.Nombre }}</p><p style='margin:0;color:#565a61;font-size:14px;'>solicita cotización de <b style='color:#b5121f;'>{{ $json.body['Tipo de Mudanza'] }}</b>.</p></td></tr><tr><td style='padding:12px 32px 6px;'><table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='font-size:14px;color:#14181f;'><tr><td style='padding:9px 0;border-bottom:1px solid #e9e9e7;color:#565a61;width:150px;'>Correo</td><td style='padding:9px 0;border-bottom:1px solid #e9e9e7;'>{{ $json.body.email }}</td></tr><tr><td style='padding:9px 0;border-bottom:1px solid #e9e9e7;color:#565a61;'>Teléfono</td><td style='padding:9px 0;border-bottom:1px solid #e9e9e7;'>{{ $json.body.Teléfono }}</td></tr><tr><td style='padding:9px 0;border-bottom:1px solid #e9e9e7;color:#565a61;'>Origen</td><td style='padding:9px 0;border-bottom:1px solid #e9e9e7;'>{{ $json.body.Origen }}</td></tr><tr><td style='padding:9px 0;border-bottom:1px solid #e9e9e7;color:#565a61;'>Destino</td><td style='padding:9px 0;border-bottom:1px solid #e9e9e7;'>{{ $json.body.Destino }}</td></tr><tr><td style='padding:9px 0;border-bottom:1px solid #e9e9e7;color:#565a61;'>Fecha aprox.</td><td style='padding:9px 0;border-bottom:1px solid #e9e9e7;'>{{ $json.body['Fecha aproximada'] }}</td></tr><tr><td style='padding:9px 0;border-bottom:1px solid #e9e9e7;color:#565a61;'>Empaque</td><td style='padding:9px 0;border-bottom:1px solid #e9e9e7;'>{{ $json.body['Servicio de empaque'] }}</td></tr><tr><td style='padding:9px 0;border-bottom:1px solid #e9e9e7;color:#565a61;'>Idioma</td><td style='padding:9px 0;border-bottom:1px solid #e9e9e7;'>{{ $json.body.lang === 'en' ? 'Inglés' : 'Español' }}</td></tr></table></td></tr><tr><td style='padding:8px 32px 4px;'><p style='margin:0 0 4px;color:#565a61;font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;'>Detalles</p><p style='margin:0;color:#3f444c;font-size:14px;line-height:1.6;background:#f6f6f5;border:1px solid #e9e9e7;padding:12px 14px;'>{{ $json.body.Detalles || '—' }}</p></td></tr><tr><td style='padding:18px 32px 26px;'><a href='mailto:{{ $json.body.email }}' style='display:inline-block;background:#e11d2e;color:#ffffff;font-weight:800;font-size:14px;text-decoration:none;padding:13px 24px;text-transform:uppercase;letter-spacing:.04em;'>Responder al cliente</a></td></tr><tr><td style='background:#14181f;padding:16px 32px;text-align:center;'><span style='color:#7d7f83;font-size:11px;'>Lead capturado desde {{ $('Config').item.json.siteDomain }} · Elemento Web</span></td></tr></table></td></tr></table>",
        "options": {
          "appendAttribution": false,
          "bccEmail": "={{ $('Config').item.json.bccEmail }}",
          "replyTo": "={{ $json.body.email }}"
        }
      },
      "credentials": {
        "smtp": { "id": "brevosmtp0001", "name": "SMTP Brevo" }
      }
    },
    {
      "id": "b1c2d3e4-0005-4000-8000-000000000005",
