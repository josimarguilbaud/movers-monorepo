---
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DestinationDetail from '../../../components/DestinationDetail.astro';
import { destinations } from '../../../data/destinations';

export function getStaticPaths() {
  return destinations.map((d) => ({ params: { slug: d.slug.en }, props: { d } }));
}

const { d } = Astro.props;

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `Moving from Panama to ${d.country.en}`,
    description: d.metaDescription.en,
    serviceType: 'International moving',
    areaServed: [
      { '@type': 'Country', name: 'Panama' },
      { '@type': 'Country', name: d.country.en },
    ],
    provider: { '@type': 'MovingCompany', name: 'Panamá Worldwide Express' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://panamaworldwideexpress.com/en/' },
      { '@type': 'ListItem', position: 2, name: 'Destinations', item: 'https://panamaworldwideexpress.com/en/destinations/' },
      { '@type': 'ListItem', position: 3, name: d.country.en },
    ],
  },
];
---

<Base
  title={d.metaTitle.en}
  description={d.metaDescription.en}
  lang="en"
  altPaths={{ es: `/es/destinos/${d.slug.es}/`, en: `/en/destinations/${d.slug.en}/` }}
  jsonld={jsonld}
>
  <Header locale="en" />
  <DestinationDetail locale="en" d={d} />
  <Footer locale="en" />
</Base>
