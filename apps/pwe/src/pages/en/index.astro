---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { wa } from '../../data/site';

const services = [
  { n: '01', ic: '🌎', t: 'International Moving', d: 'To and from Panama — sea, air and door to door, with full customs handling.' },
  { n: '02', ic: '🚚', t: 'National Moving', d: 'Between provinces, from the capital to the countryside and back, with clear routes and timelines.' },
  { n: '03', ic: '🏙️', t: 'Local Moving', d: 'Within Panama City and metro areas — including last-minute express service.' },
  { n: '04', ic: '🏢', t: 'Corporate / Office', d: 'We relocate your company over the weekend so you operate without interruption on Monday.' },
  { n: '05', ic: '📦', t: 'Cargo & Logistics', d: 'Air, sea and land freight — consolidated or exclusive, door to door.' },
  { n: '06', ic: '🏬', t: 'Storage', d: 'Secure, monitored warehouses to store your goods or inventory for as long as you need.' },
];
const cities = ['Panama City', 'David · Chiriquí', 'Colón', 'Coronado', 'Santiago', 'Chitré', 'Boquete', 'Bocas del Toro'];
const corridors = [
  { to: 'United States', via: 'Sea · Air' },
  { to: 'Spain', via: 'Container · Door to door' },
  { to: 'Latin America', via: 'Land · Sea' },
];
const why = [
  { k: '⚡', t: 'Fast response', d: 'A quote in under 24 hours and a flexible schedule, even for last-minute moves.' },
  { k: '🛡️', t: 'Insured cargo', d: 'Every move is protected and documented — you always know where your cargo is.' },
  { k: '👷', t: 'In-house team', d: 'Trained staff and our own fleet: we never subcontract your move to third parties.' },
];
const posts = [
  { tag: 'Corporate', t: 'How to move your office without losing a workday' },
  { tag: 'National', t: 'Checklist for a cross-province move in Panama' },
  { tag: 'Cargo', t: 'Sea or air freight: which one fits your shipment' },
];
---

<Base
  title="Panamá Worldwide Express | Moving & logistics across Panama"
  description="National, corporate and cargo moving across Panama — plus international outbound to the USA, Spain and Latin America. Get a quote in 2 minutes with PWE."
  lang="en"
  altPaths={{ es: '/es/', en: '/en/' }}
>
  <Header locale="en" />

  <!-- HERO -->
  <section class="relative bg-brand-900 text-white overflow-hidden">
    <div class="max-w-[1180px] mx-auto px-6">
      <div class="grid lg:grid-cols-[1.05fr_.95fr] min-h-[560px]">
        <div class="flex flex-col justify-center py-16 lg:py-20 relative z-20">
          <div class="max-w-[560px] lg:pr-10">
            <span class="inline-flex items-center gap-2 text-xs font-extrabold tracking-[0.16em] uppercase text-accent-500 before:content-[''] before:w-6 before:h-0.5 before:bg-accent-500">International · National · Corporate · Cargo</span>
            <h1 class="text-4xl md:text-6xl font-black leading-[1.04] tracking-tight my-5">Moving & logistics that <span class="text-accent-500">move Panama</span> and the world.</h1>
            <p class="text-lg text-brand-300 max-w-[480px]">International, national, corporate and cargo moving — to and from Panama, to any destination. Fast, coordinated and hassle-free.</p>
            <div class="flex flex-wrap gap-3.5 mt-8">
              <a href="/en/contact/" class="bg-accent-500 text-white font-extrabold px-6 py-3.5 hover:bg-accent-600 transition-colors flex items-center gap-2">Get a quote in 2 minutes <span class="font-black">→</span></a>
              <a href="/en/services/" class="border-2 border-white/25 text-white font-extrabold px-6 py-3.5 hover:bg-white/10 transition-colors">See services</a>
            </div>
          </div>
        </div>
        <div class="relative hidden lg:block">
          <img src="/img/hero-truck.jpg" alt="PWE cargo truck" class="absolute inset-0 w-full h-full object-cover" />
          <div class="absolute inset-0 z-10" style="background:linear-gradient(90deg,#14181f 0%,rgba(20,24,31,.55) 26%,rgba(20,24,31,.12) 60%);"></div>
          <div class="absolute -left-0.5 inset-y-0 w-[70px] bg-accent-500 skew-x-[-9deg] z-20 opacity-90"></div>
        </div>
      </div>
    </div>
    <div class="bg-accent-500">
      <div class="max-w-[1180px] mx-auto px-6 flex flex-wrap gap-x-10 gap-y-2 py-3.5 text-[13.5px] font-extrabold uppercase tracking-wide">
        <span class="flex items-center gap-2 before:content-['›'] before:text-lg before:opacity-70">Nationwide coverage</span>
        <span class="flex items-center gap-2 before:content-['›'] before:text-lg before:opacity-70">Office moves</span>
        <span class="flex items-center gap-2 before:content-['›'] before:text-lg before:opacity-70">Air & sea freight</span>
        <span class="flex items-center gap-2 before:content-['›'] before:text-lg before:opacity-70">Secure storage</span>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <div class="bg-white border-b border-brand-200">
    <div class="max-w-[1180px] mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-6 py-9">
      <div><div class="text-3xl md:text-4xl font-black tracking-tight text-brand-900"><span class="text-accent-500">10</span> prov.</div><div class="text-[13px] text-brand-400 font-semibold mt-0.5">Coverage across Panama</div></div>
      <div><div class="text-3xl md:text-4xl font-black tracking-tight text-brand-900"><span class="text-accent-500">24</span>h</div><div class="text-[13px] text-brand-400 font-semibold mt-0.5">Response to your quote</div></div>
      <div><div class="text-3xl md:text-4xl font-black tracking-tight text-brand-900"><span class="text-accent-500">+15</span>k</div><div class="text-[13px] text-brand-400 font-semibold mt-0.5">Boxes moved per year</div></div>
      <div><div class="text-3xl md:text-4xl font-black tracking-tight text-brand-900">100<span class="text-accent-500">%</span></div><div class="text-[13px] text-brand-400 font-semibold mt-0.5">Insured cargo</div></div>
    </div>
  </div>

  <!-- FEATURED: INTERNATIONAL -->
  <section class="pt-20">
    <div class="max-w-[1180px] mx-auto px-6">
      <div class="grid lg:grid-cols-2 border border-brand-200 bg-white overflow-hidden">
        <div class="relative min-h-[300px] lg:min-h-full">
          <img src="/img/yard.jpg" alt="PWE international moving" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
          <span class="absolute top-0 left-0 bg-accent-500 text-white text-[11px] font-black uppercase tracking-[0.14em] px-4 py-2">Featured service</span>
        </div>
        <div class="p-8 lg:p-12">
          <span class="inline-flex items-center gap-2 text-xs font-extrabold tracking-[0.16em] uppercase text-accent-500 before:content-[''] before:w-6 before:h-0.5 before:bg-accent-500">International Moving</span>
          <h2 class="text-3xl md:text-4xl font-black tracking-tight text-brand-900 mt-3 mb-4">Your international move, to and from Panama</h2>
          <p class="text-brand-500 text-base mb-6">We coordinate the whole move: exclusive or shared sea container, air freight, customs handling and door-to-door delivery — to the United States, Spain, Latin America and any destination in the world.</p>
          <div class="grid grid-cols-2 gap-3 mb-7">
            {['Sea container (FCL/LCL)', 'Air freight', 'Customs handling', 'Door to door'].map((f) => (
              <div class="flex items-center gap-2.5 text-sm font-bold text-brand-800"><span class="text-accent-500 font-black">✓</span> {f}</div>
            ))}
          </div>
          <a href="/en/services/" class="inline-flex bg-brand-900 text-white font-extrabold px-6 py-3.5 hover:bg-brand-800 transition-colors">Get an international quote →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="py-20">
    <div class="max-w-[1180px] mx-auto px-6">
      <div class="max-w-[640px] mb-9">
        <span class="inline-flex items-center gap-2 text-xs font-extrabold tracking-[0.16em] uppercase text-accent-500 before:content-[''] before:w-6 before:h-0.5 before:bg-accent-500">What we do</span>
        <h2 class="text-3xl md:text-5xl font-black tracking-tight text-brand-900 mt-3 mb-2.5">Services to move your home, your office and your cargo</h2>
        <p class="text-brand-400 text-lg">From a single apartment to relocating an entire company — with the team and trucks to do it right.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-brand-200 border border-brand-200">
        {services.map((s) => (
          <div class="group bg-white p-7 relative hover:bg-brand-50 transition-colors">
            <div class="text-xs font-black text-accent-500 tracking-widest">{s.n}</div>
            <div class="w-11 h-11 bg-brand-900 text-white grid place-items-center text-2xl my-3.5">{s.ic}</div>
            <h3 class="text-lg font-extrabold text-brand-900 mb-2">{s.t}</h3>
            <p class="text-brand-400 text-[14.5px]">{s.d}</p>
            <span class="absolute left-0 bottom-0 h-[3px] w-0 bg-accent-500 group-hover:w-full transition-all duration-200"></span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COVERAGE -->
  <section class="bg-brand-900 text-white py-20">
    <div class="max-w-[1180px] mx-auto px-6 grid lg:grid-cols-[1fr_1.1fr] gap-12 items-center">
      <div>
        <span class="inline-flex items-center gap-2 text-xs font-extrabold tracking-[0.16em] uppercase text-accent-500 before:content-[''] before:w-6 before:h-0.5 before:bg-accent-500">Where we reach</span>
        <h2 class="text-3xl md:text-4xl font-black tracking-tight my-3.5">All of Panama — and out to the world</h2>
        <p class="text-brand-300 text-base">We operate in the country's main cities and coordinate your international outbound from anywhere.</p>
        <div class="flex flex-wrap gap-2.5 mt-6">
          {cities.map((c) => <span class="border border-white/15 px-4 py-2.5 font-bold text-sm flex items-center gap-2 before:content-[''] before:w-[7px] before:h-[7px] before:bg-accent-500">{c}</span>)}
        </div>
      </div>
      <div>
        <span class="inline-flex items-center gap-2 text-xs font-extrabold tracking-[0.16em] uppercase text-accent-400 before:content-[''] before:w-6 before:h-0.5 before:bg-accent-400">Outbound corridors</span>
        <div class="mt-3.5">
          {corridors.map((c) => (
            <div class="flex items-center gap-3.5 py-4 border-b border-white/10 font-extrabold text-lg">Panama <span class="text-accent-500 font-black">→</span> {c.to} <small class="ml-auto text-brand-300 font-semibold text-[13px]">{c.via}</small></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- WHY -->
  <section class="py-20">
    <div class="max-w-[1180px] mx-auto px-6">
      <div class="max-w-[640px] mb-9">
        <span class="inline-flex items-center gap-2 text-xs font-extrabold tracking-[0.16em] uppercase text-accent-500 before:content-[''] before:w-6 before:h-0.5 before:bg-accent-500">Why PWE</span>
        <h2 class="text-3xl md:text-5xl font-black tracking-tight text-brand-900 mt-3">Logistics that won't leave you halfway</h2>
      </div>
      <div class="grid lg:grid-cols-3 gap-6">
        {why.map((w) => (
          <div class="border border-brand-200 bg-white p-7 shadow-sm">
            <div class="w-11 h-11 grid place-items-center text-xl font-black text-accent-500" style="background:rgba(225,29,46,.10);">{w.k}</div>
            <h3 class="text-lg font-extrabold text-brand-900 mt-4 mb-2">{w.t}</h3>
            <p class="text-brand-400 text-[14.5px]">{w.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BLOG -->
  <section class="pb-20">
    <div class="max-w-[1180px] mx-auto px-6">
      <div class="flex justify-between items-end mb-8 gap-4">
        <div>
          <span class="inline-flex items-center gap-2 text-xs font-extrabold tracking-[0.16em] uppercase text-accent-500 before:content-[''] before:w-6 before:h-0.5 before:bg-accent-500">Guides & resources</span>
          <h2 class="text-3xl md:text-5xl font-black tracking-tight text-brand-900 mt-3">Tips to move stress-free</h2>
        </div>
        <a href="/en/blog/" class="border-2 border-brand-900 text-brand-900 font-extrabold px-5 py-3 hover:bg-brand-900 hover:text-white transition-colors shrink-0 hidden sm:block">See the blog (9) →</a>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {posts.map((p) => (
          <a href="/en/blog/" class="border border-brand-200 bg-white overflow-hidden flex flex-col group">
            <div class="h-[150px] relative" style="background:linear-gradient(120deg,#14181f,#2a323d);"><span class="absolute left-0 bottom-0 w-16 h-[5px] bg-accent-500"></span></div>
            <div class="p-5.5"><span class="text-[11px] font-black tracking-[0.08em] uppercase text-accent-500">{p.tag}</span><h3 class="text-[17px] font-extrabold text-brand-900 mt-2 leading-tight group-hover:text-accent-600 transition-colors">{p.t}</h3></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-accent-500 text-white">
    <div class="max-w-[1180px] mx-auto px-6 flex flex-wrap items-center justify-between gap-6" style="padding-top:3.25rem;padding-bottom:3.25rem;">
      <h2 class="text-2xl md:text-4xl font-black max-w-[640px]">Ready to move your home, your office or your cargo?</h2>
      <a href="/en/contact/" class="bg-white text-brand-900 font-extrabold px-7 py-4 hover:bg-brand-50 transition-colors">Request your quote →</a>
    </div>
  </section>

  <Footer locale="en" />

  <a href={wa('Hi, I would like a quote from PWE.')} target="_blank" rel="noopener" class="fixed bottom-6 right-6 z-50 w-14 h-14 rounded-full bg-green-500 grid place-items-center shadow-lg" aria-label="WhatsApp">
    <svg viewBox="0 0 24 24" fill="white" class="w-7 h-7"><path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.39c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.9-4.44 9.9-9.9S17.5 2 12.04 2Zm5.8 14.16c-.24.68-1.2 1.26-1.98 1.42-.53.11-1.22.2-3.56-.76-2.99-1.24-4.91-4.27-5.06-4.47-.15-.2-1.22-1.62-1.22-3.09s.77-2.19 1.04-2.49c.27-.3.59-.37.79-.37.2 0 .39.002.56.01.18.008.42-.07.66.5.24.58.82 2 .89 2.14.07.15.12.32.02.52-.1.2-.15.32-.3.5-.15.18-.31.4-.44.53-.15.15-.3.31-.13.6.17.3.76 1.25 1.63 2.02 1.12 1 2.07 1.31 2.36 1.46.29.15.46.12.63-.07.17-.2.73-.85.92-1.14.2-.29.39-.24.66-.15.27.1 1.7.8 1.99.95.29.15.48.22.55.34.07.13.07.72-.17 1.4Z"/></svg>
  </a>
</Base>
