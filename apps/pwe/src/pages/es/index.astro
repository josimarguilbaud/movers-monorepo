---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { wa } from '../../data/site';

const services = [
  { n: '01', ic: '🚚', t: 'Mudanzas Nacionales', d: 'Entre provincias, de la capital al interior y viceversa, con ruta y tiempos claros.' },
  { n: '02', ic: '🏙️', t: 'Mudanzas Locales', d: 'Dentro de Ciudad de Panamá y áreas metro, incluso servicio express de última hora.' },
  { n: '03', ic: '🏢', t: 'Corporativas / Oficinas', d: 'Reubicamos tu empresa en fin de semana para que el lunes operes sin interrupción.' },
  { n: '04', ic: '📦', t: 'Carga y Logística', d: 'Carga aérea, marítima y terrestre, consolidada o exclusiva, puerta a puerta.' },
  { n: '05', ic: '🏬', t: 'Almacenaje / Storage', d: 'Bodegas seguras y monitoreadas para guardar tu menaje o inventario el tiempo que necesites.' },
  { n: '06', ic: '🌎', t: 'Salida Internacional', d: 'De Panamá a Estados Unidos, España y Latinoamérica, con toda la gestión aduanera.' },
];
const cities = ['Ciudad de Panamá', 'David · Chiriquí', 'Colón', 'Coronado', 'Santiago', 'Chitré', 'Boquete', 'Bocas del Toro'];
const corridors = [
  { to: 'Estados Unidos', via: 'Marítimo · Aéreo' },
  { to: 'España', via: 'Contenedor · Puerta a puerta' },
  { to: 'Latinoamérica', via: 'Terrestre · Marítimo' },
];
const why = [
  { k: '⚡', t: 'Respuesta rápida', d: 'Cotización en menos de 24 horas y agenda flexible, incluso para mudanzas de último minuto.' },
  { k: '🛡️', t: 'Carga asegurada', d: 'Cada traslado va protegido y documentado — sabes dónde está tu carga en todo momento.' },
  { k: '👷', t: 'Equipo propio', d: 'Personal capacitado y flota propia: no subcontratamos tu mudanza a terceros.' },
];
const posts = [
  { tag: 'Corporativo', t: 'Cómo mudar tu oficina sin perder un día de trabajo' },
  { tag: 'Nacional', t: 'Checklist para una mudanza entre provincias en Panamá' },
  { tag: 'Carga', t: 'Carga marítima o aérea: cuál conviene según tu envío' },
];
---

<Base
  title="Panamá Worldwide Express | Mudanzas y logística en todo Panamá"
  description="Mudanzas nacionales, corporativas y de carga en todo Panamá — y salida internacional a USA, España y Latinoamérica. Cotiza en 2 minutos con PWE."
  lang="es"
  altPaths={{ es: '/es/', en: '/en/' }}
>
  <Header locale="es" />

  <!-- HERO -->
  <section class="relative bg-brand-900 text-white overflow-hidden">
    <div class="max-w-[1180px] mx-auto px-6">
      <div class="grid lg:grid-cols-[1.05fr_.95fr] min-h-[560px]">
        <div class="flex flex-col justify-center py-16 lg:py-20 relative z-20">
          <div class="max-w-[560px] lg:pr-10">
            <span class="inline-flex items-center gap-2 text-xs font-extrabold tracking-[0.16em] uppercase text-accent-500 before:content-[''] before:w-6 before:h-0.5 before:bg-accent-500">Nacional · Corporativo · Carga</span>
            <h1 class="text-4xl md:text-6xl font-black leading-[1.04] tracking-tight my-5">El motor que <span class="text-accent-500">mueve a Panamá</span>, de punta a punta.</h1>
            <p class="text-lg text-brand-300 max-w-[480px]">Mudanzas nacionales, reubicación de oficinas y carga a todo el país — y de Panamá al mundo. Rápido, coordinado y sin complicaciones.</p>
            <div class="flex flex-wrap gap-3.5 mt-8">
              <a href="/es/contacto/" class="bg-accent-500 text-white font-extrabold px-6 py-3.5 hover:bg-accent-600 transition-colors flex items-center gap-2">Cotiza en 2 minutos <span class="font-black">→</span></a>
              <a href="/es/servicios/" class="border-2 border-white/25 text-white font-extrabold px-6 py-3.5 hover:bg-white/10 transition-colors">Ver servicios</a>
            </div>
          </div>
        </div>
        <div class="relative hidden lg:block">
          <img src="/img/hero-truck.jpg" alt="Camión de carga PWE" class="absolute inset-0 w-full h-full object-cover" />
          <div class="absolute inset-0 z-10" style="background:linear-gradient(90deg,#14181f 0%,rgba(20,24,31,.55) 26%,rgba(20,24,31,.12) 60%);"></div>
          <div class="absolute -left-0.5 inset-y-0 w-[70px] bg-accent-500 skew-x-[-9deg] z-20 opacity-90"></div>
        </div>
      </div>
    </div>
    <div class="bg-accent-500">
      <div class="max-w-[1180px] mx-auto px-6 flex flex-wrap gap-x-10 gap-y-2 py-3.5 text-[13.5px] font-extrabold uppercase tracking-wide">
        <span class="flex items-center gap-2 before:content-['›'] before:text-lg before:opacity-70">Cobertura nacional</span>
        <span class="flex items-center gap-2 before:content-['›'] before:text-lg before:opacity-70">Mudanzas de oficina</span>
        <span class="flex items-center gap-2 before:content-['›'] before:text-lg before:opacity-70">Carga aérea y marítima</span>
        <span class="flex items-center gap-2 before:content-['›'] before:text-lg before:opacity-70">Almacenaje seguro</span>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <div class="bg-white border-b border-brand-200">
    <div class="max-w-[1180px] mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-6 py-9">
      <div><div class="text-3xl md:text-4xl font-black tracking-tight text-brand-900"><span class="text-accent-500">10</span> prov.</div><div class="text-[13px] text-brand-400 font-semibold mt-0.5">Cobertura en todo Panamá</div></div>
      <div><div class="text-3xl md:text-4xl font-black tracking-tight text-brand-900"><span class="text-accent-500">24</span>h</div><div class="text-[13px] text-brand-400 font-semibold mt-0.5">Respuesta a tu cotización</div></div>
      <div><div class="text-3xl md:text-4xl font-black tracking-tight text-brand-900"><span class="text-accent-500">+15</span>k</div><div class="text-[13px] text-brand-400 font-semibold mt-0.5">Cajas movidas al año</div></div>
      <div><div class="text-3xl md:text-4xl font-black tracking-tight text-brand-900">100<span class="text-accent-500">%</span></div><div class="text-[13px] text-brand-400 font-semibold mt-0.5">Carga asegurada</div></div>
    </div>
  </div>

  <!-- SERVICES -->
  <section class="py-20">
    <div class="max-w-[1180px] mx-auto px-6">
      <div class="max-w-[640px] mb-9">
        <span class="inline-flex items-center gap-2 text-xs font-extrabold tracking-[0.16em] uppercase text-accent-500 before:content-[''] before:w-6 before:h-0.5 before:bg-accent-500">Lo que hacemos</span>
        <h2 class="text-3xl md:text-5xl font-black tracking-tight text-brand-900 mt-3 mb-2.5">Servicios para mover tu casa, tu oficina y tu carga</h2>
        <p class="text-brand-400 text-lg">Desde un apartamento hasta el traslado completo de una empresa — con el equipo y los camiones para hacerlo bien.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-brand-200 border border-brand-200">
        {services.map((s) => (
          <div class="group bg-white p-7 relative hover:bg-brand-50 transition-colors">
            <div class="text-xs font-black text-accent-500 tracking-widest">{s.n}</div>
            <div class="w-11 h-11 bg-brand-900 text-white grid place-items-center text-2xl my-3.5">{s.ic}</div>
            <h3 class="text-lg font-extrabold text-brand-900 mb-2">{s.t}</h3>
            <p class="text-brand-400 text-[14.5px]">{s.d}</p>
            <span class="absolute left-0 bottom-0 h-[3px] w-0 bg-accent-500 group-hover:w-full transition-all duration-200"></span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COVERAGE -->
  <section class="bg-brand-900 text-white py-20">
    <div class="max-w-[1180px] mx-auto px-6 grid lg:grid-cols-[1fr_1.1fr] gap-12 items-center">
      <div>
        <span class="inline-flex items-center gap-2 text-xs font-extrabold tracking-[0.16em] uppercase text-accent-500 before:content-[''] before:w-6 before:h-0.5 before:bg-accent-500">Dónde llegamos</span>
        <h2 class="text-3xl md:text-4xl font-black tracking-tight my-3.5">Todo Panamá — y salida al mundo</h2>
        <p class="text-brand-300 text-base">Operamos en las principales ciudades del país y coordinamos tu salida internacional desde cualquier punto.</p>
        <div class="flex flex-wrap gap-2.5 mt-6">
          {cities.map((c) => <span class="border border-white/15 px-4 py-2.5 font-bold text-sm flex items-center gap-2 before:content-[''] before:w-[7px] before:h-[7px] before:bg-accent-500">{c}</span>)}
        </div>
      </div>
      <div>
        <span class="inline-flex items-center gap-2 text-xs font-extrabold tracking-[0.16em] uppercase text-accent-400 before:content-[''] before:w-6 before:h-0.5 before:bg-accent-400">Corredores de salida</span>
        <div class="mt-3.5">
          {corridors.map((c) => (
            <div class="flex items-center gap-3.5 py-4 border-b border-white/10 font-extrabold text-lg">Panamá <span class="text-accent-500 font-black">→</span> {c.to} <small class="ml-auto text-brand-300 font-semibold text-[13px]">{c.via}</small></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- WHY -->
  <section class="py-20">
    <div class="max-w-[1180px] mx-auto px-6">
      <div class="max-w-[640px] mb-9">
        <span class="inline-flex items-center gap-2 text-xs font-extrabold tracking-[0.16em] uppercase text-accent-500 before:content-[''] before:w-6 before:h-0.5 before:bg-accent-500">Por qué PWE</span>
        <h2 class="text-3xl md:text-5xl font-black tracking-tight text-brand-900 mt-3">Logística que no te deja a medias</h2>
      </div>
      <div class="grid lg:grid-cols-3 gap-6">
        {why.map((w) => (
          <div class="border border-brand-200 bg-white p-7 shadow-sm">
            <div class="w-11 h-11 grid place-items-center text-xl font-black text-accent-500" style="background:rgba(225,29,46,.10);">{w.k}</div>
            <h3 class="text-lg font-extrabold text-brand-900 mt-4 mb-2">{w.t}</h3>
            <p class="text-brand-400 text-[14.5px]">{w.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BLOG -->
  <section class="pb-20">
    <div class="max-w-[1180px] mx-auto px-6">
      <div class="flex justify-between items-end mb-8 gap-4">
        <div>
          <span class="inline-flex items-center gap-2 text-xs font-extrabold tracking-[0.16em] uppercase text-accent-500 before:content-[''] before:w-6 before:h-0.5 before:bg-accent-500">Guías y recursos</span>
          <h2 class="text-3xl md:text-5xl font-black tracking-tight text-brand-900 mt-3">Consejos para mover sin estrés</h2>
        </div>
        <a href="/es/blog/" class="border-2 border-brand-900 text-brand-900 font-extrabold px-5 py-3 hover:bg-brand-900 hover:text-white transition-colors shrink-0 hidden sm:block">Ver el blog (9) →</a>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {posts.map((p) => (
          <a href="/es/blog/" class="border border-brand-200 bg-white overflow-hidden flex flex-col group">
            <div class="h-[150px] relative" style="background:linear-gradient(120deg,#14181f,#2a323d);"><span class="absolute left-0 bottom-0 w-16 h-[5px] bg-accent-500"></span></div>
            <div class="p-5.5"><span class="text-[11px] font-black tracking-[0.08em] uppercase text-accent-500">{p.tag}</span><h3 class="text-[17px] font-extrabold text-brand-900 mt-2 leading-tight group-hover:text-accent-600 transition-colors">{p.t}</h3></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-accent-500 text-white">
    <div class="max-w-[1180px] mx-auto px-6 flex flex-wrap items-center justify-between gap-6 py-13" style="padding-top:3.25rem;padding-bottom:3.25rem;">
      <h2 class="text-2xl md:text-4xl font-black max-w-[640px]">¿Listo para mover tu casa, tu oficina o tu carga?</h2>
      <a href="/es/contacto/" class="bg-white text-brand-900 font-extrabold px-7 py-4 hover:bg-brand-50 transition-colors">Solicita tu cotización →</a>
    </div>
  </section>

  <Footer locale="es" />

  <a href={wa()} target="_blank" rel="noopener" class="fixed bottom-6 right-6 z-50 w-14 h-14 rounded-full bg-green-500 grid place-items-center shadow-lg" aria-label="WhatsApp">
    <svg viewBox="0 0 24 24" fill="white" class="w-7 h-7"><path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.39c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.9-4.44 9.9-9.9S17.5 2 12.04 2Zm5.8 14.16c-.24.68-1.2 1.26-1.98 1.42-.53.11-1.22.2-3.56-.76-2.99-1.24-4.91-4.27-5.06-4.47-.15-.2-1.22-1.62-1.22-3.09s.77-2.19 1.04-2.49c.27-.3.59-.37.79-.37.2 0 .39.002.56.01.18.008.42-.07.66.5.24.58.82 2 .89 2.14.07.15.12.32.02.52-.1.2-.15.32-.3.5-.15.18-.31.4-.44.53-.15.15-.3.31-.13.6.17.3.76 1.25 1.63 2.02 1.12 1 2.07 1.31 2.36 1.46.29.15.46.12.63-.07.17-.2.73-.85.92-1.14.2-.29.39-.24.66-.15.27.1 1.7.8 1.99.95.29.15.48.22.55.34.07.13.07.72-.17 1.4Z"/></svg>
  </a>
</Base>
