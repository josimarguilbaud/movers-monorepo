---
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DestinationDetail from '../../../components/DestinationDetail.astro';
import { destinations } from '../../../data/destinations';

export function getStaticPaths() {
  return destinations.map((d) => ({ params: { slug: d.slug.es }, props: { d } }));
}

const { d } = Astro.props;

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `Mudanza de Panamá a ${d.country.es}`,
    description: d.metaDescription.es,
    serviceType: 'Mudanza internacional',
    areaServed: [
      { '@type': 'Country', name: 'Panamá' },
      { '@type': 'Country', name: d.country.es },
    ],
    provider: { '@type': 'MovingCompany', name: 'Panamá Worldwide Express' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://panamaworldwideexpress.com/es/' },
      { '@type': 'ListItem', position: 2, name: 'Destinos', item: 'https://panamaworldwideexpress.com/es/destinos/' },
      { '@type': 'ListItem', position: 3, name: d.country.es },
    ],
  },
];
---

<Base
  title={d.metaTitle.es}
  description={d.metaDescription.es}
  lang="es"
  altPaths={{ es: `/es/destinos/${d.slug.es}/`, en: `/en/destinations/${d.slug.en}/` }}
  jsonld={jsonld}
>
  <Header locale="es" />
  <DestinationDetail locale="es" d={d} />
  <Footer locale="es" />
</Base>
