---
/* Cuerpo de la home. Compartido ES/EN.

   Reescrita el 2026-08-17: la versión anterior anunciaba "Carga y Logística" y
   "Almacenaje" con descripciones inventadas, y mostraba cifras sin ninguna
   fuente ("10 provincias", "+15k cajas al año"). Ahora los servicios salen de
   services.ts y las cifras son solo las que el cliente puede sostener.

   Redisño visual 2026-08-22 (dirección aprobada por el cliente, ver
   pwe_redesign.html): estructura y formas nuevas, mismo contenido real. Sin
   testimonios: el mockup traía tres inventados y no hay reseñas reales que
   publicar todavía (decisión de Josimar). */
import { Icon } from 'astro-icon/components';
import { services } from '../data/services';
import { destinations } from '../data/destinations';
import { principles, process as howItWorks } from '../data/content';
import { wa, claimedExperience } from '../data/site';

interface Props {
  locale: 'es' | 'en';
}
const { locale } = Astro.props;
const list = services[locale];
const featuredDest = destinations.filter((d) => d.featured);
const P = principles[locale].slice(0, 3);
const steps = howItWorks[locale];
const contact = locale === 'es' ? '/es/contacto/' : '/en/contact/';
const servicesBase = locale === 'es' ? '/es/servicios/' : '/en/services/';
const destBase = locale === 'es' ? '/es/destinos/' : '/en/destinations/';
const intlSlug = locale === 'es' ? 'mudanzas-internacionales' : 'international-moving';
const waHref = wa(locale === 'es' ? 'Hola, quiero cotizar una mudanza con PWE.' : 'Hi, I would like a quote from PWE.');
/* Iconos de la franja flotante del hero, en el mismo orden que T.band. */
const bandIcons = ['fa6-solid:file-signature', 'fa6-solid:house', 'fa6-solid:paw', 'fa6-solid:box-open'];

const T = {
  es: {
    kicker: 'Internacional · Nacional · Corporativo · Carga',
    h1a: 'Mudanzas y logística que ',
    h1b: 'mueven a Panamá',
    h1c: ' y al mundo.',
    lead: 'Mudanzas internacionales, locales, de oficina y carga, desde y hacia Panamá. Nos encargamos también de la aduana, que es donde la mayoría se atasca.',
    cta1: 'Cotiza en 2 minutos',
    cta2: 'Ver servicios',
    band: ['Gestión aduanera incluida', 'Evaluación gratuita a domicilio', 'Mascotas y vehículos', 'Contenedor compartido'],
    /* Solo cifras que el cliente puede sostener. Las anteriores ("10 prov",
       "+15k cajas al año") no tenían ninguna fuente. */
    stats: [
      { n: '+25', u: 'años', d: 'Moviendo casas y empresas' },
      { n: '24', u: 'h', d: 'Respuesta a tu cotización' },
      { n: '3', u: 'vías', d: 'Aérea, marítima y terrestre' },
      { n: '0', u: '$', d: 'Cuesta la evaluación' },
    ],
    featKicker: 'Servicio destacado',
    featTitle: 'Tu mudanza internacional, desde y hacia Panamá',
    featText: 'Coordinamos todo el traslado: contenedor marítimo exclusivo o compartido, envío aéreo, gestión aduanera y entrega puerta a puerta, a cualquier destino del mundo.',
    featBullets: ['Contenedor exclusivo o compartido', 'Envío aéreo', 'Gestión aduanera', 'Puerta a puerta'],
    featCta: 'Cómo funciona →',
    svcKicker: 'Lo que hacemos',
    svcTitle: 'Once servicios para mover tu casa, tu oficina y tu carga',
    svcLead: 'Desde un apartamento hasta el traslado completo de una empresa, con el equipo y los camiones para hacerlo bien.',
    svcAll: 'Ver todos los servicios',
    destKicker: 'A dónde llegamos',
    destTitle: 'Salida al mundo desde Panamá',
    destLead: 'Estos son los corredores que más movemos. Cada uno con sus tiempos y lo que pide su aduana.',
    destAll: 'Ver todos los destinos',
    whyKicker: 'Por qué PWE',
    whyTitle: 'Logística que no te deja a medias',
    procKicker: 'El proceso PWE',
    procTitle: 'De la primera llamada a la última caja',
    ctaTitle: '¿Listo para cotizar?',
    ctaText: 'Cuéntanos qué tienes que mover. La evaluación es gratis y la cotización llega en menos de 24 horas.',
    ctaBtn: 'Cotizar gratis',
  },
  en: {
    kicker: 'International · Domestic · Corporate · Freight',
    h1a: 'Moving and logistics that ',
    h1b: 'move Panama',
    h1c: ' and the world.',
    lead: 'International, local, office moving, and freight, to and from Panama. We handle customs too, which is where most people get stuck.',
    cta1: 'Get a quote in 2 minutes',
    cta2: 'See services',
    band: ['Customs handling included', 'Free at-home assessment', 'Pets and vehicles', 'Shared container'],
    stats: [
      { n: '25+', u: 'years', d: 'Moving homes and businesses' },
      { n: '24', u: 'h', d: 'To answer your quote' },
      { n: '3', u: 'modes', d: 'Air, ocean, and overland' },
      { n: '0', u: '$', d: 'Cost of the assessment' },
    ],
    featKicker: 'Featured service',
    featTitle: 'Your international move, to and from Panama',
    featText: 'We coordinate the whole thing: exclusive or shared ocean container, air freight, customs handling, and door-to-door delivery anywhere in the world.',
    featBullets: ['Exclusive or shared container', 'Air freight', 'Customs handling', 'Door to door'],
    featCta: 'How it works →',
    svcKicker: 'What we do',
    svcTitle: 'Eleven services to move your home, your office, and your freight',
    svcLead: 'From a single apartment to relocating an entire company, with the crew and the trucks to do it properly.',
    svcAll: 'See all services',
    destKicker: 'Where we reach',
    destTitle: 'Out of Panama to the world',
    destLead: 'These are the corridors we run most. Each with its timings and what its customs authority asks for.',
    destAll: 'See all destinations',
    whyKicker: 'Why PWE',
    whyTitle: 'Logistics that does not leave you halfway',
    procKicker: 'The PWE process',
    procTitle: 'From the first call to the last box',
    ctaTitle: 'Ready for a quote?',
    ctaText: 'Tell us what you need to move. The assessment is free and the quote arrives within 24 hours.',
    ctaBtn: 'Get a free quote',
  },
}[locale];
---

<!-- HERO -->
<section class="relative bg-brand-900 text-white overflow-hidden pt-14 pb-28 lg:pt-20 lg:pb-36">
  <div class="absolute inset-0 z-0">
    <img src="/img/hero-truck.jpg" alt="Camión de PWE" class="w-full h-full object-cover object-center opacity-50" />
    <div class="absolute inset-0" style="background:linear-gradient(90deg,#0a2540 0%,rgba(10,37,64,.88) 45%,rgba(10,37,64,.65) 100%);"></div>
  </div>

  <div class="max-w-[1180px] mx-auto px-6 relative z-10">
    <div class="lg:w-2/3">
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 border border-white/20 backdrop-blur-sm text-accent-400 text-xs font-bold tracking-wide uppercase mb-6">{T.kicker}</span>
      <h1 class="text-4xl md:text-6xl font-extrabold leading-[1.08] tracking-tight mb-6">{T.h1a}<span class="text-accent-500">{T.h1b}</span>{T.h1c}</h1>
      <p class="text-lg md:text-xl text-brand-300 max-w-2xl font-light leading-relaxed mb-10">{T.lead}</p>
      <div class="flex flex-wrap gap-4">
        <a href={contact} class="bg-accent-500 hover:bg-accent-600 text-white font-bold px-8 py-4 rounded-xl transition-all transform hover:-translate-y-1 shadow-xl shadow-accent-500/20 flex items-center gap-2.5">{T.cta1} <span class="font-black">→</span></a>
        <a href={servicesBase} class="bg-white/10 hover:bg-white/15 border border-white/20 backdrop-blur-sm text-white font-bold px-8 py-4 rounded-xl transition-colors">{T.cta2}</a>
      </div>
    </div>
  </div>

  <!-- Franja flotante -->
  <div class="absolute bottom-0 left-0 w-full translate-y-1/2 z-20 hidden lg:block">
    <div class="max-w-[1180px] mx-auto px-6">
      <div class="grid grid-cols-4 gap-4 bg-white rounded-2xl shadow-2xl p-6 border border-brand-100">
        {T.band.map((b, i) => (
          <div class={`flex items-center gap-3.5 ${i > 0 ? 'pl-4 border-l border-brand-100' : ''}`}>
            <div class="bg-brand-50 w-11 h-11 rounded-xl flex items-center justify-center text-accent-500 shrink-0">
              <Icon name={bandIcons[i]} class="text-lg" />
            </div>
            <p class="text-[13px] font-bold text-brand-900 leading-tight">{b}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- STATS -->
<div class="bg-white pt-20 pb-4 lg:pt-28">
  <div class="max-w-[1180px] mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-6 py-9 border-b border-brand-100">
    {T.stats.map((s) => (
      <div>
        <div class="text-3xl md:text-4xl font-extrabold tracking-tight text-brand-900">
          <span class="text-accent-500">{s.n}</span> {s.u}
        </div>
        <div class="text-[13px] text-brand-400 font-semibold mt-1">{s.d}</div>
      </div>
    ))}
  </div>
</div>

<!-- DESTACADO: INTERNACIONAL -->
<section class="pt-16 lg:pt-20">
  <div class="max-w-[1180px] mx-auto px-6">
    <div class="grid lg:grid-cols-2 rounded-3xl bg-white shadow-card overflow-hidden">
      <div class="relative min-h-[300px] lg:min-h-full">
        <img src="/img/yard.jpg" alt="Mudanzas internacionales PWE" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
        <span class="absolute top-6 left-6 bg-accent-500 text-white text-[11px] font-bold uppercase tracking-[0.14em] px-4 py-2 rounded-full shadow-lg">{T.featKicker}</span>
      </div>
      <div class="p-8 lg:p-12">
        <span class="inline-flex items-center gap-2 text-xs font-bold tracking-[0.16em] uppercase text-accent-500 before:content-[''] before:w-6 before:h-0.5 before:bg-accent-500">{list[0].title}</span>
        <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-brand-900 mt-3 mb-4">{T.featTitle}</h2>
        <p class="text-brand-500 text-base mb-6">{T.featText}</p>
        <div class="grid grid-cols-2 gap-3 mb-8">
          {T.featBullets.map((f) => (
            <div class="flex items-center gap-2.5 text-sm font-bold text-brand-800">
              <span class="w-5 h-5 rounded-full bg-accent-500/10 text-accent-500 flex items-center justify-center text-xs shrink-0"><Icon name="fa6-solid:check" /></span> {f}
            </div>
          ))}
        </div>
        <a href={`${servicesBase}${intlSlug}/`} class="inline-flex bg-brand-900 hover:bg-brand-800 text-white font-bold px-6 py-3.5 rounded-xl transition-colors">{T.featCta}</a>
      </div>
    </div>
  </div>
</section>

<!-- SERVICIOS -->
<section class="py-20">
  <div class="max-w-[1180px] mx-auto px-6">
    <div class="max-w-[640px] mb-9">
      <span class="inline-flex items-center gap-2 text-xs font-extrabold tracking-[0.16em] uppercase text-accent-500 before:content-[''] before:w-6 before:h-0.5 before:bg-accent-500">{T.svcKicker}</span>
      <h2 class="text-3xl md:text-5xl font-black tracking-tight text-brand-900 mt-3 mb-2.5">{T.svcTitle}</h2>
      <p class="text-brand-400 text-lg">{T.svcLead}</p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {list.map((s, i) => (
        <a href={`${servicesBase}${s.slug[locale]}/`} class={`group bg-white rounded-2xl shadow-card hover:-translate-y-1.5 transition-all duration-300 p-7 relative overflow-hidden ${i === list.length - 1 ? 'sm:col-span-2 lg:col-span-1' : ''}`}>
          <div class="text-xs font-bold text-accent-500 tracking-widest mb-2">{s.n}</div>
          <div class="w-13 h-13 rounded-xl bg-brand-50 text-brand-900 grid place-items-center text-2xl mb-4 group-hover:bg-accent-500 group-hover:text-white transition-colors">{s.ic}</div>
          <h3 class="text-lg font-extrabold text-brand-900 mb-2">{s.title}</h3>
          <p class="text-brand-400 text-[14.5px] leading-relaxed">{s.tagline}</p>
          <span class="absolute left-0 bottom-0 h-1 w-0 bg-accent-500 group-hover:w-full transition-all duration-300 rounded-full"></span>
        </a>
      ))}
    </div>
    <a href={servicesBase} class="inline-block mt-8 text-sm font-bold text-accent-500 uppercase tracking-wide hover:text-accent-600 transition-colors">{T.svcAll} →</a>
  </div>
</section>

<!-- DESTINOS -->
<section class="bg-brand-900 text-white py-20 mt-16 lg:mt-20">
  <div class="max-w-[1180px] mx-auto px-6">
    <div class="max-w-[640px] mb-9">
      <span class="inline-flex items-center gap-2 text-xs font-bold tracking-[0.16em] uppercase text-accent-500 before:content-[''] before:w-6 before:h-0.5 before:bg-accent-500">{T.destKicker}</span>
      <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight my-3.5">{T.destTitle}</h2>
      <p class="text-brand-300 text-base">{T.destLead}</p>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      {featuredDest.map((d) => (
        <a href={`${destBase}${d.slug[locale]}/`} class="group bg-white/5 hover:bg-white/10 rounded-2xl border border-white/10 hover:border-accent-500/50 p-6 transition-colors">
          <span class="text-3xl">{d.flag}</span>
          <h3 class="text-xl font-extrabold mt-3">{d.country[locale]}</h3>
          <div class="flex gap-5 mt-4 pt-4 border-t border-white/10 text-[13px]">
            <div><span class="block text-brand-400 font-semibold">{locale === 'es' ? 'Marítimo' : 'Ocean'}</span><b>{d.seaWeeks} {locale === 'es' ? 'sem.' : 'wks'}</b></div>
            <div><span class="block text-brand-400 font-semibold">{locale === 'es' ? 'Aéreo' : 'Air'}</span><b>{d.airDays} {locale === 'es' ? 'días' : 'days'}</b></div>
          </div>
        </a>
      ))}
    </div>
    <a href={destBase} class="inline-block mt-8 text-sm font-bold text-accent-500 uppercase tracking-wide hover:text-accent-400 transition-colors">{T.destAll} →</a>
  </div>
</section>

<!-- POR QUÉ -->
<section class="py-20">
  <div class="max-w-[1180px] mx-auto px-6">
    <div class="max-w-[640px] mb-9">
      <span class="inline-flex items-center gap-2 text-xs font-bold tracking-[0.16em] uppercase text-accent-500 before:content-[''] before:w-6 before:h-0.5 before:bg-accent-500">{T.whyKicker}</span>
      <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight text-brand-900 mt-3">{T.whyTitle}</h2>
    </div>
    <div class="grid lg:grid-cols-3 gap-6">
      {P.map((w) => (
        <div class="bg-white rounded-2xl shadow-card p-7">
          <div class="w-11 h-11 rounded-xl grid place-items-center text-lg font-extrabold text-accent-500 bg-accent-500/10">{w.k}</div>
          <h3 class="text-lg font-extrabold text-brand-900 mt-4 mb-2">{w.t}</h3>
          <p class="text-brand-400 text-[14.5px] leading-relaxed">{w.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- PROCESO -->
<section class="py-20 bg-brand-50">
  <div class="max-w-[1180px] mx-auto px-6">
    <div class="max-w-[640px] mb-12">
      <span class="inline-flex items-center gap-2 text-xs font-bold tracking-[0.16em] uppercase text-accent-500 before:content-[''] before:w-6 before:h-0.5 before:bg-accent-500">{T.procKicker}</span>
      <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-brand-900 mt-3">{T.procTitle}</h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {steps.map((s) => (
        <div class="bg-white rounded-2xl shadow-card p-6">
          <div class="w-10 h-10 rounded-full bg-brand-900 text-white grid place-items-center font-bold text-sm">{s.n}</div>
          <h4 class="font-extrabold text-lg text-brand-900 mt-4 mb-1.5">{s.t}</h4>
          <p class="text-brand-400 text-sm leading-relaxed">{s.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA -->
<section class="relative bg-accent-500 text-white py-16 overflow-hidden">
  <div class="absolute top-0 right-0 -mt-20 -mr-20 w-80 h-80 bg-white opacity-10 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 left-0 -mb-20 -ml-20 w-64 h-64 bg-black opacity-10 rounded-full blur-2xl"></div>
  <div class="max-w-[1180px] mx-auto px-6 relative z-10 flex flex-col lg:flex-row lg:items-center gap-8 justify-between">
    <div>
      <h2 class="text-3xl lg:text-[42px] font-extrabold tracking-tight">{T.ctaTitle}</h2>
      <p class="mt-2.5 max-w-xl opacity-90">{T.ctaText}</p>
    </div>
    <div class="flex flex-wrap gap-3.5 shrink-0">
      <a href={contact} class="bg-white text-accent-600 font-bold px-7 py-4 rounded-xl hover:bg-brand-50 hover:shadow-2xl transition-all transform hover:-translate-y-1">{T.ctaBtn}</a>
      <a href={waHref} target="_blank" rel="noopener" class="bg-[#25D366] hover:bg-[#20b858] font-bold px-7 py-4 rounded-xl transition-all transform hover:-translate-y-1 flex items-center gap-2.5"><Icon name="fa6-brands:whatsapp" class="text-xl" /> WhatsApp</a>
    </div>
  </div>
</section>
