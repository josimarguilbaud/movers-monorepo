---
import { Icon } from 'astro-icon/components';
import { contactForm } from '../data/site';

interface Props {
  locale?: 'es' | 'en';
}
const { locale = 'es' } = Astro.props;

const T = {
  es: {
    subject: 'Nueva solicitud de cotización — Panamá Worldwide Express',
    fromName: 'Sitio web PWE',
    name: 'Nombre completo', namePh: 'Ej. Juan Pérez',
    /* Tipos alineados con los servicios que el cliente presta de verdad
       (ver panamaworldwideexpress.com). El sitio publicado usa solo Local e
       Internacional; se añade Oficinas porque cambia mucho la cotización. */
    type: 'Tipo de mudanza',
    local: 'Local', intl: 'Internacional', office: 'Oficina',
    email: 'Correo electrónico', emailPh: 'correo@ejemplo.com',
    date: 'Fecha aproximada',
    phone: 'Teléfono (WhatsApp)', phonePh: '+507 0000-0000',
    packing: '¿Necesita servicio de empaque?', yes: 'Sí', no: 'No',
    origin: 'Origen', originPh: 'Ej. Ciudad de Panamá',
    dest: 'Destino', destPh: 'Ej. David, Chiriquí',
    details: 'Detalles', detailsPh: 'Volumen aproximado, si incluye vehículo, fechas críticas, etc.',
    send: 'Solicitar cotización', sending: 'Enviando…',
    consent: 'Al enviar acepta ser contactado por PWE. No compartimos sus datos.',
    okTitle: '¡Solicitud recibida!',
    okText: 'Gracias por escribir a PWE. Revisamos su solicitud y le contactamos en menos de 24 horas.',
    another: 'Enviar otra solicitud',
    errConfig: 'El formulario está en configuración. Escríbanos por WhatsApp mientras tanto.',
    errSend: 'No se pudo enviar. Intente de nuevo o escríbanos por WhatsApp.',
    errNet: 'Error de conexión. Intente de nuevo o escríbanos por WhatsApp.',
  },
  en: {
    subject: 'New quote request — Panamá Worldwide Express',
    fromName: 'PWE website',
    name: 'Full name', namePh: 'e.g. John Smith',
    type: 'Type of move',
    local: 'Local', intl: 'International', office: 'Office',
    email: 'Email address', emailPh: 'you@example.com',
    date: 'Approximate date',
    phone: 'Phone (WhatsApp)', phonePh: '+507 0000-0000',
    packing: 'Do you need packing service?', yes: 'Yes', no: 'No',
    origin: 'Origin', originPh: 'e.g. Panama City',
    dest: 'Destination', destPh: 'e.g. David, Chiriquí',
    details: 'Details', detailsPh: 'Approximate volume, whether a vehicle is included, critical dates, etc.',
    send: 'Request a quote', sending: 'Sending…',
    consent: 'By submitting you agree to be contacted by PWE. We never share your data.',
    okTitle: 'Request received!',
    okText: 'Thanks for reaching out to PWE. We are reviewing your request and will get back to you within 24 hours.',
    another: 'Send another request',
    errConfig: 'The form is being set up. Please reach us on WhatsApp in the meantime.',
    errSend: 'Could not send. Please try again or reach us on WhatsApp.',
    errNet: 'Connection error. Please try again or reach us on WhatsApp.',
  },
}[locale];

/* Marca PWE: angular, sin esquinas redondeadas, acento rojo. */
const inputCls =
  'w-full px-4 py-3.5 border border-brand-200 bg-white text-brand-900 placeholder:text-brand-300 focus:border-accent-500 focus:ring-2 focus:ring-accent-500/25 outline-none transition-colors';
const labelCls = 'block text-[11px] font-extrabold text-brand-500 uppercase tracking-[0.14em] mb-2';
const optCls =
  'block text-center px-3 py-3 border border-brand-200 bg-white text-brand-600 font-extrabold text-[13px] cursor-pointer peer-checked:bg-brand-900 peer-checked:text-white peer-checked:border-brand-900 hover:border-accent-500 transition-colors';
---

<div class="quote-form-wrap">
  <form
    id="quote-form"
    data-endpoint={contactForm.leadWebhook}
    data-send={T.send}
    data-err-config={T.errConfig}
    data-err-send={T.errSend}
    data-err-net={T.errNet}
    class="space-y-5"
  >
    <!-- n8n usa esto para responderle al cliente en su idioma. -->
    <input type="hidden" name="lang" value={locale} />
    <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <!-- Nombre -->
    <div>
      <label class={labelCls} for="pwe-nombre">{T.name} <span class="text-accent-500">*</span></label>
      <input id="pwe-nombre" name="Nombre" type="text" class={inputCls} placeholder={T.namePh} required />
    </div>

    <!-- Tipo de servicio -->
    <div>
      <label class={labelCls}>{T.type} <span class="text-accent-500">*</span></label>
      <div class="grid grid-cols-3 gap-2.5">
        <label>
          <input type="radio" name="Tipo de Mudanza" value="Local" class="peer sr-only" required />
          <span class={optCls}>{T.local}</span>
        </label>
        <label>
          <input type="radio" name="Tipo de Mudanza" value="Internacional" class="peer sr-only" />
          <span class={optCls}>{T.intl}</span>
        </label>
        <label>
          <input type="radio" name="Tipo de Mudanza" value="Oficina" class="peer sr-only" />
          <span class={optCls}>{T.office}</span>
        </label>
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-5">
      <!-- Correo -->
      <div>
        <label class={labelCls} for="pwe-email">{T.email} <span class="text-accent-500">*</span></label>
        <input id="pwe-email" name="email" type="email" class={inputCls} placeholder={T.emailPh} required />
      </div>
      <!-- Fecha -->
      <div>
        <label class={labelCls} for="pwe-fecha">{T.date} <span class="text-accent-500">*</span></label>
        <input id="pwe-fecha" name="Fecha aproximada" type="date" class={inputCls} required />
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-5">
      <!-- Teléfono -->
      <div>
        <label class={labelCls} for="pwe-tel">{T.phone} <span class="text-accent-500">*</span></label>
        <input id="pwe-tel" name="Teléfono" type="tel" class={inputCls} placeholder={T.phonePh} required />
      </div>
      <!-- Empaque -->
      <div>
        <label class={labelCls}>{T.packing}</label>
        <div class="grid grid-cols-2 gap-2.5">
          <label>
            <input type="radio" name="Servicio de empaque" value="Sí" class="peer sr-only" />
            <span class={optCls}>{T.yes}</span>
          </label>
          <label>
            <input type="radio" name="Servicio de empaque" value="No" class="peer sr-only" />
            <span class={optCls}>{T.no}</span>
          </label>
        </div>
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-5">
      <!-- Origen -->
      <div>
        <label class={labelCls} for="pwe-origen">{T.origin} <span class="text-accent-500">*</span></label>
        <input id="pwe-origen" name="Origen" type="text" class={inputCls} placeholder={T.originPh} required />
      </div>
      <!-- Destino -->
      <div>
        <label class={labelCls} for="pwe-destino">{T.dest} <span class="text-accent-500">*</span></label>
        <input id="pwe-destino" name="Destino" type="text" class={inputCls} placeholder={T.destPh} required />
      </div>
    </div>

    <!-- Detalles -->
    <div>
      <label class={labelCls} for="pwe-detalles">{T.details}</label>
      <textarea id="pwe-detalles" name="Detalles" rows="3" class={`${inputCls} resize-none`} placeholder={T.detailsPh}></textarea>
    </div>

    <button type="submit" id="quote-submit" class="w-full bg-accent-500 text-white font-extrabold py-4 hover:bg-accent-600 transition-colors flex justify-center items-center gap-2.5 mt-1 text-[15px] uppercase tracking-wide disabled:opacity-70">
      {T.send} <Icon name="fa6-solid:arrow-right" />
    </button>
    <p id="form-error" class="hidden text-sm text-accent-600 text-center font-semibold"></p>
    <p class="text-[11px] text-brand-400 text-center">{T.consent}</p>
  </form>

  <div id="form-success" class="hidden text-center py-16">
    <div class="w-16 h-16 bg-brand-900 text-white grid place-items-center text-2xl mx-auto mb-6"><Icon name="fa6-solid:check" /></div>
    <!-- h3 y no h4: el formulario va bajo un h2, y saltar un nivel rompe la
         jerarquía de encabezados que leen los lectores de pantalla y Google. -->
    <h3 class="text-3xl font-black text-brand-900 mb-3 tracking-tight">{T.okTitle}</h3>
    <p class="text-brand-500 mb-8 max-w-md mx-auto">{T.okText}</p>
    <button id="reset-form-btn" class="text-accent-500 font-extrabold uppercase text-sm tracking-wide hover:text-accent-600 transition-colors">{T.another}</button>
  </div>
</div>

<script>
  const form = document.getElementById('quote-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('form-success');
  const errorMsg = document.getElementById('form-error');
  const submitBtn = document.getElementById('quote-submit') as HTMLButtonElement | null;
  const resetBtn = document.getElementById('reset-form-btn');
  const endpoint = form?.dataset.endpoint || '';
  const sendLabel = form?.dataset.send || 'Enviar';
  const msgConfig = form?.dataset.errConfig || '';
  const msgSend = form?.dataset.errSend || '';
  const msgNet = form?.dataset.errNet || '';

  const showError = (msg: string) => { if (errorMsg) { errorMsg.textContent = msg; errorMsg.classList.remove('hidden'); } };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg?.classList.add('hidden');

    if (!endpoint) {
      showError(msgConfig);
      return;
    }
    if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = '…'; }

    try {
      // urlencoded = "simple request": el navegador no manda preflight CORS.
      const body = new URLSearchParams(new FormData(form) as any).toString();
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body,
      });
      let ok = res.ok;
      try { const j = await res.json(); ok = ok && (j.success !== false); } catch {}
      if (ok) {
        form.classList.add('hidden');
        successMsg?.classList.remove('hidden');
      } else {
        showError(msgSend);
      }
    } catch {
      showError(msgNet);
    } finally {
      if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = sendLabel; }
    }
  });

  resetBtn?.addEventListener('click', () => {
    form?.reset();
    successMsg?.classList.add('hidden');
    form?.classList.remove('hidden');
  });
</script>
