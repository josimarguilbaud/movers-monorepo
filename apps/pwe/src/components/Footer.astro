---
import { site } from '../data/site';

interface Props {
  locale: 'es' | 'en';
}
const { locale } = Astro.props;
const base = `/${locale}/`;
const seg = locale === 'es'
  ? { servicios: 'servicios', cobertura: 'cobertura', nosotros: 'nosotros', blog: 'blog', contacto: 'contacto', recursos: 'recursos' }
  : { servicios: 'services', cobertura: 'coverage', nosotros: 'about', blog: 'blog', contacto: 'contact', resources: 'resources', recursos: 'resources' };

const L = {
  es: {
    blurb: 'Mudanzas y logística en todo Panamá, y salida al mundo. Rápido, seguro y con equipo propio.',
    servicios: 'Servicios', cobertura: 'Cobertura', empresa: 'Empresa',
    s: ['Nacionales', 'Locales', 'Corporativas', 'Carga', 'Almacenaje'],
    c: ['Ciudad de Panamá', 'Chiriquí', 'Colón', 'Interior', 'Salida internacional'],
    e: ['Nosotros', 'Blog', 'Contacto', 'Cotizar'],
    rights: 'Todos los derechos reservados.', madeWith: 'Desarrollado por',
  },
  en: {
    blurb: 'Moving and logistics across Panama, and out to the world. Fast, safe, and with our own team.',
    servicios: 'Services', cobertura: 'Coverage', empresa: 'Company',
    s: ['National', 'Local', 'Corporate', 'Cargo', 'Storage'],
    c: ['Panama City', 'Chiriquí', 'Colón', 'Countryside', 'International outbound'],
    e: ['About', 'Blog', 'Contact', 'Get a quote'],
    rights: 'All rights reserved.', madeWith: 'Built by',
  },
}[locale];

const sHref = [`${base}${seg.servicios}/`, `${base}${seg.servicios}/`, `${base}${seg.servicios}/`, `${base}${seg.servicios}/`, `${base}${seg.servicios}/`];
const cHref = [`${base}${seg.cobertura}/`, `${base}${seg.cobertura}/`, `${base}${seg.cobertura}/`, `${base}${seg.cobertura}/`, `${base}${seg.cobertura}/`];
const eHref = [`${base}${seg.nosotros}/`, `${base}${seg.blog}/`, `${base}${seg.contacto}/`, `${base}${seg.contacto}/`];
---

<footer class="bg-brand-900 text-brand-400 pt-14 pb-7">
  <div class="max-w-[1180px] mx-auto px-6">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 pb-9 border-b border-white/10">
      <div>
        <a href={base} class="flex items-center gap-3 mb-4">
          <span class="relative w-10 h-10 bg-white text-brand-900 grid place-items-center font-black text-[15px] overflow-hidden">
            PWE<span class="absolute -right-1.5 inset-y-0 w-3 bg-accent-500 skew-x-[-16deg]"></span>
          </span>
          <span class="leading-none">
            <span class="block font-black text-[16px] text-white tracking-tight">Panamá Worldwide</span>
            <span class="block text-[9px] font-extrabold tracking-[0.22em] uppercase text-accent-500 mt-[3px]">Express · Logística</span>
          </span>
        </a>
        <p class="text-sm max-w-[260px] text-brand-400">{L.blurb}</p>
      </div>
      <div>
        <h4 class="text-white text-[13px] font-extrabold uppercase tracking-wider mb-3.5">{L.servicios}</h4>
        {L.s.map((label, i) => <a href={sHref[i]} class="block text-sm py-[5px] hover:text-accent-400 transition-colors">{label}</a>)}
      </div>
      <div>
        <h4 class="text-white text-[13px] font-extrabold uppercase tracking-wider mb-3.5">{L.cobertura}</h4>
        {L.c.map((label, i) => <a href={cHref[i]} class="block text-sm py-[5px] hover:text-accent-400 transition-colors">{label}</a>)}
      </div>
      <div>
        <h4 class="text-white text-[13px] font-extrabold uppercase tracking-wider mb-3.5">{L.empresa}</h4>
        {L.e.map((label, i) => <a href={eHref[i]} class="block text-sm py-[5px] hover:text-accent-400 transition-colors">{label}</a>)}
      </div>
    </div>
    <div class="pt-5 flex flex-wrap justify-between gap-2 text-[13px]">
      <span>&copy; 2026 {site.name} · {L.rights}</span>
      <span>{L.madeWith} <a href="https://elementoweb.com" target="_blank" rel="noopener" class="text-brand-400 hover:text-accent-400 font-bold">Elemento Web</a></span>
    </div>
  </div>
</footer>
