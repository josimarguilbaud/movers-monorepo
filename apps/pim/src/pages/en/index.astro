---
import Base from '../../layouts/Base.astro';
import { Icon } from 'astro-icon/components';
---

<Base
  title="Panama International Movers S.A. | International Moving"
  description="International and local moving from Panama with over 30 years of experience."
  lang="en"
>
  <section class="min-h-screen bg-brand-900 text-white flex items-center justify-center px-6">
    <div class="text-center">
      <h1 class="text-5xl md:text-6xl font-extrabold mb-4">
        Panama International <span class="text-accent-500">Movers</span>
      </h1>
      <p class="text-brand-200 max-w-md mx-auto">English skeleton page.</p>
      <div class="mt-8 flex justify-center gap-6 text-accent-500 text-3xl">
        <Icon name="fa6-solid:ship" />
      </div>
    </div>
  </section>
</Base>
