---
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { Icon } from 'astro-icon/components';
import { getCollection, render } from 'astro:content';
import { site, wa } from '../../../data/site';
import { breadcrumb } from '@movers/core/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blogEn', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const url = `${site.domain}/en/blog/${post.id}/`;
const crumbs = breadcrumb([
  { name: 'Home', url: `${site.domain}/en/` },
  { name: 'Blog', url: `${site.domain}/en/blog/` },
  { name: post.data.title, url },
]);
/* `heroImage` viene relativo ("/img/pim-ship.jpg") y Google no resuelve rutas
   relativas dentro del JSON-LD: hay que darle la URL absoluta. */
/* Igual que en español: sin gemelo declarado, no se emite alterna. */
const altPaths = post.data.translation
  ? { es: `/es/blog/${post.data.translation}/`, en: `/en/blog/${post.id}/` }
  : undefined;

const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  image: new URL(post.data.heroImage, site.domain).href,
  datePublished: post.data.pubDate.toISOString(),
  author: { '@type': 'Organization', name: post.data.author },
  publisher: { '@type': 'Organization', name: site.name },
  mainEntityOfPage: url,
};
---

<Base
  title={`${post.data.title} | PIM Blog`}
  description={post.data.description}
  lang="en"
  image={post.data.heroImage}
  altPaths={altPaths}
  jsonld={[crumbs, article]}
>
  <Header locale="en" />

  <article>
    <section class="relative pt-40 pb-20 bg-brand-900 overflow-hidden">
      <img src={post.data.heroImage} alt={post.data.title} class="absolute inset-0 w-full h-full object-cover opacity-25" />
      <div class="absolute inset-0" style="background:linear-gradient(160deg, rgba(10,25,47,0.9), rgba(10,25,47,0.97));"></div>
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <nav class="text-sm text-brand-300 mb-6 flex gap-2 flex-wrap"><a href="/en/" class="hover:text-accent-400">Home</a><span>/</span><a href="/en/blog/" class="hover:text-accent-400">Blog</a><span>/</span><span class="text-accent-400">Article</span></nav>
        <span class="text-xs font-bold text-accent-500 uppercase tracking-widest">{post.data.category}</span>
        <h1 class="text-3xl md:text-5xl font-black text-white my-5 leading-tight">{post.data.title}</h1>
        <p class="text-brand-300 text-sm flex items-center gap-2"><Icon name="fa6-solid:calendar" /> {fmt(post.data.pubDate)} · {post.data.author}</p>
      </div>
    </section>

    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="article">
        <Content />
      </div>

      <div class="mt-16 rounded-3xl bg-brand-900 p-8 md:p-10 text-center">
        <h3 class="text-2xl font-black text-white mb-3">¿Planeando su mudanza internacional?</h3>
        <p class="text-brand-300 mb-6">Solicite una cotización gratuita y sin compromiso. Le respondemos en menos de 24 horas.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/en/#contacto" class="bg-accent-500 text-brand-900 px-8 py-4 rounded-tr-2xl rounded-bl-2xl font-bold hover:bg-accent-400 transition-all">Cotizar mi Mudanza</a>
          <a href={wa()} target="_blank" rel="noopener" class="px-8 py-4 rounded-tr-2xl rounded-bl-2xl font-bold text-white border-2 border-white/30 hover:bg-white/10 transition-all flex items-center justify-center gap-2"><Icon name="fa6-brands:whatsapp" class="text-green-400 text-xl" /> WhatsApp</a>
        </div>
      </div>
    </div>
  </article>

  <Footer locale="en" />
  <a href={wa()} target="_blank" rel="noopener" class="fixed bottom-6 right-6 z-50 w-14 h-14 rounded-full bg-green-500 grid place-items-center shadow-lg" aria-label="WhatsApp"><Icon name="fa6-brands:whatsapp" class="text-white text-3xl" /></a>
</Base>

<style is:global>
  .article { color: #34485d; font-size: 1.075rem; line-height: 1.8; }
  .article h2 { font-size: 1.7rem; font-weight: 800; color: #0a192f; margin: 2.2rem 0 1rem; letter-spacing: -0.02em; }
  .article h3 { font-size: 1.3rem; font-weight: 700; color: #0a192f; margin: 1.8rem 0 .8rem; }
  .article p { margin-bottom: 1.2rem; }
  .article ul, .article ol { margin: 0 0 1.2rem 1.4rem; }
  .article ul { list-style: disc; }
  .article ol { list-style: decimal; }
  .article li { margin-bottom: .5rem; }
  .article strong { color: #0a192f; font-weight: 700; }
  .article a { color: #d97706; font-weight: 600; text-decoration: underline; }
  .article a:hover { color: #0a192f; }
  .article blockquote { border-left: 4px solid #f59e0b; background: #f4f6f8; padding: 1rem 1.4rem; border-radius: 0 .75rem .75rem 0; margin: 1.6rem 0; font-style: italic; }
  .article blockquote p { margin: 0; }
</style>
