---
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { Icon } from 'astro-icon/components';
import { wa } from '../../../data/site';
import { breadcrumb } from '@movers/core/schema';

const crumbs = breadcrumb([
  { name: 'Home', url: 'https://panamainternationalmovers.com/en/' },
  { name: 'Resources', url: 'https://panamainternationalmovers.com/en/resources/' },
  { name: 'Moving Checklist', url: 'https://panamainternationalmovers.com/en/resources/international-moving-checklist/' },
]);

const phases = [
  {
    when: '2–3 months before',
    icon: 'fa6-solid:calendar-days',
    items: [
      'Request quotes and choose your moving company.',
      'Schedule the volume survey (in person or via video call).',
      'Review the customs and residency requirements for your destination country.',
      'Decide what to take, what to sell, what to donate, and what to discard.',
      'Check that everyone’s passports and visas are valid.',
    ],
  },
  {
    when: '1 month before',
    icon: 'fa6-solid:calendar-check',
    items: [
      'Confirm the moving date and type of service (sea/air, FCL/LCL).',
      'Arrange insurance and set the declared value of your household goods.',
      'Gather your documentation: inventory, property titles, certificates.',
      'Notify address changes (banks, service providers, subscriptions).',
      'Arrange pet relocation if applicable (vaccinations, certificates).',
    ],
  },
  {
    when: '1 week before',
    icon: 'fa6-solid:box',
    items: [
      'Pack a bag with essentials for the first few weeks.',
      'Set aside the personal documents that will travel with you (never in the container).',
      'Empty, defrost, and dry the refrigerator and other appliances.',
      'Confirm access, elevators, and time windows at both origin and destination.',
      'Back up important digital files.',
    ],
  },
  {
    when: 'Moving day',
    icon: 'fa6-solid:truck-fast',
    items: [
      'Walk through the inventory as the crew packs and loads.',
      'Check that every box is labeled by contents and room.',
      'Keep documents, jewelry, medications, and high-value items with you.',
      'Do a final walk-through of the empty home before locking up.',
    ],
  },
  {
    when: 'Arriving at destination',
    icon: 'fa6-solid:house-chimney-window',
    items: [
      'Coordinate customs clearance with your agent (your coordinator manages it).',
      'Check the inventory against what’s delivered.',
      'Report any damage immediately to activate your insurance.',
      'Enjoy move-in day: we deliver, unpack the basics, and remove the packing material.',
    ],
  },
];
---

<Base
  title="International Moving Checklist (Downloadable) | PIM Panama"
  description="A step-by-step checklist for your international move: what to do 3 months, 1 month, and 1 week before, on moving day, and on arrival. Stay organized and never miss a step."
  lang="en"
  altPaths={{ es: '/es/recursos/checklist-mudanza-internacional/', en: '/en/resources/international-moving-checklist/' }}
  jsonld={crumbs}
>
  <Header locale="en" />

  <section class="relative pt-40 pb-20 bg-brand-900 overflow-hidden">
    <div class="absolute inset-0" style="background:linear-gradient(160deg, rgba(10,25,47,0.92), rgba(10,25,47,0.98));"></div>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <nav class="text-sm text-brand-300 mb-6 flex gap-2 flex-wrap"><a href="/en/" class="hover:text-accent-400">Home</a><span>/</span><a href="/en/resources/" class="hover:text-accent-400">Resources</a><span>/</span><span class="text-accent-400">Checklist</span></nav>
      <h1 class="text-4xl md:text-5xl font-black text-white mb-5 leading-tight">International Moving Checklist</h1>
      <p class="text-brand-200 text-lg">The complete list so you don't forget a thing, from three months out to the day you settle into your new home.</p>
    </div>
  </section>

  <section class="py-16 bg-brand-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      {phases.map((phase) => (
        <div class="bg-white rounded-3xl p-8 border border-brand-100 shadow-sm">
          <div class="flex items-center gap-4 mb-6">
            <div class="w-12 h-12 rounded-xl bg-brand-900 text-accent-400 flex items-center justify-center text-xl"><Icon name={phase.icon} /></div>
            <h2 class="text-2xl font-black text-brand-900">{phase.when}</h2>
          </div>
          <ul class="space-y-3">
            {phase.items.map((item) => (
              <li class="flex items-start gap-3 text-brand-600">
                <Icon name="fa6-solid:square-check" class="text-accent-500 text-lg mt-0.5 shrink-0" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div class="rounded-3xl bg-brand-900 p-8 md:p-10 text-center">
        <h3 class="text-2xl font-black text-white mb-3">Let us handle the list</h3>
        <p class="text-brand-300 mb-6">With a personal coordinator, every item on this checklist is covered by our team.</p>
        <a href="/en/#contacto" class="inline-block bg-accent-500 text-brand-900 px-8 py-4 rounded-tr-2xl rounded-bl-2xl font-bold hover:bg-accent-400 transition-all">Request a Quote</a>
      </div>
    </div>
  </section>

  <Footer locale="en" />
  <a href={wa()} target="_blank" rel="noopener" class="fixed bottom-6 right-6 z-50 w-14 h-14 rounded-full bg-green-500 grid place-items-center shadow-lg" aria-label="WhatsApp"><Icon name="fa6-brands:whatsapp" class="text-white text-3xl" /></a>
</Base>
