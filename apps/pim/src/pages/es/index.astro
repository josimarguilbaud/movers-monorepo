---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import { Icon } from 'astro-icon/components';
import { site, wa, yearsInBusiness } from '../../data/site';
import { services } from '../../data/services';
import { destinations } from '../../data/destinations';
import { imgFor } from '../../data/images';
import { featuredTestimonials } from '../../data/testimonials';
import { faqPage } from '@movers/core/schema';

const pick = (ids: string[]) => ids.map((id) => services.find((s) => s.id === id)!).filter(Boolean);
const featured = pick([
  'maritimas', 'fcl', 'aereas', 'auto-contenedor',
  'mascotas-internacional', 'cliente-corporativas', 'complementarios-almacenaje', 'complementarios-embalaje',
]);
const destPick = destinations; // los 8 corredores
const homeReviews = featuredTestimonials([1, 3, 11, 8, 7, 10]);

const stats = [
  { value: `${yearsInBusiness}+`, label: 'Años de Experiencia' },
  { value: 'Global', label: 'Cobertura Mundial' },
  { value: 'Puerta', label: 'a Puerta' },
  { value: '100%', label: 'Seguro a Todo Riesgo' },
];

const steps = [
  { n: '01.', icon: 'fa6-solid:clipboard-list', title: 'Inspección y Asesoría', desc: 'Evaluamos el volumen de su carga en su domicilio o por videollamada para una cotización exacta.' },
  { n: '02.', icon: 'fa6-solid:box', title: 'Embalaje Profesional', desc: 'Empacamos con materiales de calidad de exportación e inventariamos todo con detalle.' },
  { n: '03.', icon: 'fa6-solid:ship', title: 'Tránsito y Aduanas', desc: 'Gestionamos el transporte marítimo o aéreo y toda la documentación en origen y destino.' },
  { n: '04.', icon: 'fa6-solid:house-chimney-window', title: 'Entrega Final', desc: 'Descarga, desembalaje básico y retiro de material en su nuevo hogar, listo para disfrutar.' },
];

const faqs = [
  { q: '¿Con cuánto tiempo de anticipación debo contactarlos?', a: 'Recomendamos entre 4 y 6 semanas antes de su fecha deseada. Esto nos permite coordinar la inspección, tramitar el seguro y reservar espacio en navieras o aerolíneas con las mejores tarifas.' },
  { q: '¿Ustedes empacan todo o debo hacerlo yo?', a: 'Para mudanzas internacionales, el empaque profesional de nuestro equipo suele ser obligatorio por requisitos de aduanas y aseguradoras, que exigen que el contenido coincida con el inventario y esté correctamente protegido.' },
  { q: '¿Qué artículos no puedo incluir en la mudanza?', a: 'Por normativas internacionales no se transportan artículos peligrosos (inflamables, explosivos, corrosivos), perecederos, plantas, semillas, armas, municiones, joyas de alto valor no declaradas ni efectivo. Su coordinador le explicará las restricciones de su destino.' },
  { q: '¿Ofrecen seguro de carga?', a: 'Sí, pólizas a todo riesgo puerta a puerta a través de aseguradoras internacionales reconocidas. Le asesoramos sobre el valor a declarar y las coberturas.' },
];
---

<Base
  title="Mudanzas Internacionales en Panamá | Panamá International Movers S.A."
  description={`Panamá International Movers S.A.: empresa familiar con más de ${yearsInBusiness} años de experiencia en mudanzas internacionales, locales y corporativas desde Panamá. Puerta a puerta, aduanas y seguro. Cotiza gratis.`}
  lang="es"
  altPaths={{ es: '/es/', en: '/en/' }}
  jsonld={faqPage(faqs.map((f) => ({ question: f.q, answer: f.a })))}
>
  <Header locale="es" />

  <!-- HERO -->
  <section id="inicio" class="relative min-h-screen flex items-center pt-20 overflow-hidden bg-brand-900">
    <div class="absolute inset-0 z-0">
      <img src={imgFor('home-hero', 0)} alt="Mudanzas internacionales en Panamá" class="w-full h-full object-cover object-center opacity-60" />
      <div class="absolute inset-0" style="background:linear-gradient(90deg, rgba(10,25,47,0.96) 0%, rgba(10,25,47,0.75) 50%, rgba(10,25,47,0.35) 100%);"></div>
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full pb-20 pt-10">
      <div class="grid lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/20 mb-8">
            <span class="w-2 h-2 rounded-full bg-accent-500 animate-pulse"></span>
            <span class="text-xs font-bold text-white tracking-widest uppercase">Empresa familiar panameña desde 1990</span>
          </div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-white leading-[1.1] mb-6">
            Mudanzas Internacionales en Panamá,<br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent-400 to-amber-200">seguras a cualquier parte del mundo.</span>
          </h1>
          <p class="text-lg md:text-xl text-brand-200 mb-10 max-w-2xl font-light leading-relaxed">
            Con más de {yearsInBusiness} años de experiencia, coordinamos su mudanza internacional, local o corporativa puerta a puerta: embalaje, aduanas y seguro incluidos. Su transición, segura, fluida y sin estrés.
          </p>
          <div class="flex flex-col sm:flex-row gap-5">
            <a href="#contacto" class="bg-accent-500 text-brand-900 px-8 py-4 rounded-tr-2xl rounded-bl-2xl font-bold text-center shadow-lg hover:bg-accent-400 transition-all transform hover:-translate-y-1 flex justify-center items-center gap-3 text-lg">
              Cotizar mi Mudanza <Icon name="fa6-solid:arrow-right" />
            </a>
            <a href={wa()} target="_blank" rel="noopener" class="px-8 py-4 rounded-tr-2xl rounded-bl-2xl font-bold text-white border-2 border-white/30 hover:bg-white/10 backdrop-blur-sm transition-all flex justify-center items-center gap-3 text-lg">
              <Icon name="fa6-brands:whatsapp" class="text-2xl text-green-400" /> Asesoría Inmediata
            </a>
          </div>
          <!-- trust chips -->
          <div class="flex flex-wrap gap-x-8 gap-y-3 mt-10 text-sm text-brand-200">
            <span class="flex items-center gap-2"><Icon name="fa6-solid:shield-halved" class="text-accent-500" /> Seguro a todo riesgo</span>
            <span class="flex items-center gap-2"><Icon name="fa6-solid:earth-americas" class="text-accent-500" /> Red global de agentes</span>
            <span class="flex items-center gap-2"><Icon name="fa6-solid:user-tie" class="text-accent-500" /> Coordinador personal</span>
          </div>
        </div>

        <div class="hidden lg:block lg:col-span-5 relative h-full min-h-[480px]">
          <div class="absolute top-6 right-0 bg-white/10 backdrop-blur-xl border border-white/20 p-6 rounded-2xl w-72 shadow-2xl">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 bg-accent-500/20 rounded-full flex items-center justify-center text-accent-400 text-xl"><Icon name="fa6-solid:ship" /></div>
              <div><h3 class="text-white font-bold text-lg">Rutas Globales</h3><p class="text-brand-300 text-sm">Marítimo y aéreo</p></div>
            </div>
          </div>
          <div class="absolute top-44 right-24 bg-white p-6 rounded-2xl w-72 shadow-2xl">
            <div class="w-12 h-12 bg-brand-50 rounded-full flex items-center justify-center text-accent-600 text-xl mb-3"><Icon name="fa6-solid:handshake" /></div>
            <p class="text-brand-900 font-bold mb-1">Empresa Familiar</p>
            <p class="text-brand-500 text-sm">Fundada en 1990 · trato directo</p>
          </div>
          <div class="absolute bottom-6 right-8 bg-brand-800/80 backdrop-blur-xl border border-brand-700 p-6 rounded-2xl w-64 shadow-2xl">
            <div class="flex justify-between items-end">
              <div><p class="text-brand-300 text-sm mb-1">Cobertura</p><p class="text-white font-bold text-xl">Mundial</p></div>
              <div class="text-green-400 text-3xl"><Icon name="fa6-solid:earth-americas" /></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS BAR -->
  <div class="bg-accent-500 relative z-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-10">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 divide-x divide-brand-900/10">
        {stats.map((s) => (
          <div class="text-center">
            <div class="text-4xl md:text-5xl font-black text-brand-900 mb-2">{s.value}</div>
            <div class="text-sm font-bold uppercase tracking-wider text-brand-800">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- SERVICIOS DESTACADOS -->
  <section id="servicios" class="py-24 bg-brand-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row justify-between items-end mb-14 gap-6">
        <div class="max-w-2xl">
          <div class="flex items-center gap-3 mb-4"><div class="h-px w-12 bg-accent-600"></div><h2 class="text-sm font-bold text-accent-600 uppercase tracking-widest">Nuestros Servicios</h2></div>
          <h3 class="text-4xl md:text-5xl font-black text-brand-900">Soluciones integrales para su mudanza</h3>
        </div>
        <a href="/es/servicios/" class="hidden md:inline-flex items-center gap-2 text-brand-600 font-bold hover:text-accent-600 transition-colors shrink-0">Ver los 34 servicios <Icon name="fa6-solid:arrow-right-long" /></a>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {featured.map((s) => (
          <a href={`/es/servicios/${s.slug}/`} class="bg-white p-7 rounded-3xl shadow-sm hover:shadow-xl transition-all group border border-brand-100 hover:-translate-y-1">
            <div class="w-14 h-14 bg-brand-50 rounded-2xl flex items-center justify-center text-brand-900 text-2xl mb-5 group-hover:bg-accent-500 group-hover:text-white transition-colors duration-300"><Icon name={s.icon} /></div>
            <h4 class="text-lg font-bold text-brand-900 mb-2 group-hover:text-accent-600 transition-colors leading-tight">{s.title}</h4>
            <p class="text-brand-500 text-sm leading-relaxed mb-4 line-clamp-2">{s.heroTagline}</p>
            <span class="text-accent-600 font-bold text-sm flex items-center gap-1">Ver más <Icon name="fa6-solid:chevron-right" class="text-[10px] group-hover:translate-x-1 transition-transform" /></span>
          </a>
        ))}
      </div>
      <a href="/es/servicios/" class="md:hidden mt-8 inline-flex items-center gap-2 text-accent-600 font-bold">Ver los 34 servicios <Icon name="fa6-solid:arrow-right-long" /></a>
    </div>
  </section>

  <!-- DESTINOS POPULARES -->
  <section class="py-24 bg-brand-900 relative overflow-hidden">
    <img src={imgFor('home-destinos', 3)} alt="" class="absolute inset-0 w-full h-full object-cover opacity-15" />
    <div class="absolute inset-0" style="background:linear-gradient(180deg, rgba(10,25,47,0.92), rgba(10,25,47,0.97));"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <div class="flex justify-center items-center gap-3 mb-4"><div class="h-px w-12 bg-accent-500"></div><h2 class="text-sm font-bold text-accent-500 uppercase tracking-widest">Destinos</h2><div class="h-px w-12 bg-accent-500"></div></div>
        <h3 class="text-3xl md:text-5xl font-black text-white mb-4">Mudanzas desde Panamá a todo el mundo</h3>
        <p class="text-brand-300 text-lg">Corredores marítimos y aéreos con gestión aduanera resuelta en origen y destino.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {destPick.map((d) => (
          <a href={`/es/destinos/${d.slug}/`} class="group bg-brand-800/50 border border-brand-700/50 rounded-2xl p-5 hover:bg-brand-800 hover:border-accent-500 transition-all text-center">
            <div class="text-4xl mb-2">{d.flag}</div>
            <h4 class="font-bold text-white text-sm group-hover:text-accent-400 transition-colors">{d.country}</h4>
          </a>
        ))}
      </div>
      <div class="text-center mt-10"><a href="/es/destinos/" class="inline-flex items-center gap-2 text-accent-500 font-bold hover:text-accent-400">Ver todos los destinos <Icon name="fa6-solid:arrow-right" /></a></div>
    </div>
  </section>

  <!-- NOSOTROS -->
  <section id="nosotros" class="py-24 bg-white relative overflow-hidden">
    <div class="absolute top-0 right-0 w-1/3 h-full bg-brand-50 transform skew-x-12 translate-x-20 z-0"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class="relative h-[560px]">
          <div class="absolute top-0 left-0 w-4/5 h-4/5 rounded-3xl overflow-hidden shadow-2xl">
            <img src={imgFor('home-about-1', 5)} alt="Equipo de embalaje PIM" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="absolute bottom-0 right-0 w-3/5 h-3/5 rounded-3xl overflow-hidden shadow-2xl border-8 border-white">
            <img src={imgFor('home-about-2', 9)} alt="Logística de mudanzas" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="absolute top-1/2 right-8 -translate-y-1/2 bg-brand-900 text-white rounded-full w-32 h-32 flex flex-col items-center justify-center shadow-xl border-4 border-white z-20">
            <span class="text-sm font-bold text-accent-500 uppercase">Desde</span>
            <span class="text-3xl font-black">1990</span>
          </div>
        </div>
        <div>
          <div class="flex items-center gap-3 mb-4"><div class="h-px w-12 bg-accent-500"></div><h2 class="text-sm font-bold text-accent-600 uppercase tracking-widest">Nuestra Historia</h2></div>
          <h3 class="text-4xl md:text-5xl font-black text-brand-900 mb-6 leading-tight">Una empresa familiar que <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-600 to-brand-900">mueve vidas</span> desde hace {yearsInBusiness} años.</h3>
          <p class="text-brand-600 mb-6 text-lg leading-relaxed">Fundada en 1990 con valores familiares y visión global, <strong>Panamá International Movers S.A.</strong> es un referente en la logística de mudanzas internacionales en Panamá. No solo transportamos muebles: trasladamos recuerdos, sueños y el inicio de una nueva etapa.</p>
          <div class="flex flex-col sm:flex-row gap-6 mt-10 border-t border-brand-100 pt-8">
            <div class="flex gap-4 items-start">
              <div class="w-12 h-12 bg-brand-50 rounded-xl flex items-center justify-center text-accent-600 shrink-0"><Icon name="fa6-solid:handshake" class="text-xl" /></div>
              <div><h4 class="font-bold text-brand-900 mb-1">Trato directo y familiar</h4><p class="text-sm text-brand-500">Atención personal de quienes conocen su caso.</p></div>
            </div>
            <div class="flex gap-4 items-start">
              <div class="w-12 h-12 bg-brand-50 rounded-xl flex items-center justify-center text-accent-600 shrink-0"><Icon name="fa6-solid:earth-americas" class="text-xl" /></div>
              <div><h4 class="font-bold text-brand-900 mb-1">Red global de agentes</h4><p class="text-sm text-brand-500">Excelencia en el destino, en los cinco continentes.</p></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- POR QUÉ ELEGIRNOS -->
  <section class="py-24 bg-brand-950 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="flex justify-center items-center gap-3 mb-4"><div class="h-px w-12 bg-accent-500"></div><h2 class="text-sm font-bold text-accent-500 uppercase tracking-widest">Ventaja Competitiva</h2><div class="h-px w-12 bg-accent-500"></div></div>
        <h3 class="text-3xl md:text-5xl font-black mb-6">¿Por qué confiar en nosotros?</h3>
        <p class="text-brand-300 text-lg">Una mudanza internacional requiere precisión, experiencia y una red confiable. Combinamos las tres.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-brand-900/60 border border-brand-800 p-8 rounded-3xl hover:bg-brand-900 transition-colors">
          <div class="w-16 h-16 bg-brand-950 border border-brand-800 rounded-2xl flex items-center justify-center text-accent-400 text-2xl mb-6"><Icon name="fa6-solid:user-tie" /></div>
          <h4 class="text-xl font-bold mb-3">Coordinador Personal VIP</h4>
          <p class="text-brand-300 text-sm leading-relaxed">Un solo punto de contacto que lo guía en cada paso, desde la cotización hasta desempacar la última caja en destino.</p>
        </div>
        <div class="bg-brand-900/60 border border-brand-800 p-8 rounded-3xl hover:bg-brand-900 transition-colors">
          <div class="w-16 h-16 bg-brand-950 border border-brand-800 rounded-2xl flex items-center justify-center text-accent-400 text-2xl mb-6"><Icon name="fa6-solid:file-contract" /></div>
          <h4 class="text-xl font-bold mb-3">Gestión Aduanal Completa</h4>
          <p class="text-brand-300 text-sm leading-relaxed">Navegamos la burocracia por usted, en origen y destino, aprovechando las exenciones de menaje aplicables y evitando retrasos.</p>
        </div>
        <div class="bg-brand-900/60 border border-brand-800 p-8 rounded-3xl hover:bg-brand-900 transition-colors">
          <div class="w-16 h-16 bg-brand-950 border border-brand-800 rounded-2xl flex items-center justify-center text-accent-400 text-2xl mb-6"><Icon name="fa6-solid:shield-halved" /></div>
          <h4 class="text-xl font-bold mb-3">Pólizas a Todo Riesgo</h4>
          <p class="text-brand-300 text-sm leading-relaxed">Seguro internacional puerta a puerta. Sus bienes protegidos contra cualquier eventualidad marítima, aérea o terrestre.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESO -->
  <section id="proceso" class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <div class="flex justify-center items-center gap-3 mb-4"><div class="h-px w-12 bg-accent-500"></div><h2 class="text-sm font-bold text-accent-600 uppercase tracking-widest">Metodología</h2><div class="h-px w-12 bg-accent-500"></div></div>
        <h3 class="text-3xl md:text-5xl font-black text-brand-900">Su mudanza en 4 pasos</h3>
      </div>
      <div class="grid md:grid-cols-4 gap-8">
        {steps.map((st) => (
          <div class="text-center group">
            <div class="w-20 h-20 bg-brand-50 rounded-full flex items-center justify-center mx-auto mb-6 border-4 border-brand-100 group-hover:border-accent-500 transition-colors"><Icon name={st.icon} class="text-2xl text-accent-600" /></div>
            <div class="text-accent-500 font-black text-xl mb-2">{st.n}</div>
            <h4 class="font-bold text-lg mb-3 text-brand-900">{st.title}</h4>
            <p class="text-brand-500 text-sm leading-relaxed">{st.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- RESEÑAS (ready para reseñas reales de Google) -->
  <section id="testimonios" class="py-24 bg-brand-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <h2 class="text-sm font-bold text-accent-600 uppercase tracking-widest mb-2">Lo que dicen nuestros clientes</h2>
        <h3 class="text-3xl md:text-4xl font-black text-brand-900 mb-4">Historias de mudanzas exitosas</h3>
        <div class="inline-flex items-center gap-3 bg-white rounded-full px-5 py-2.5 shadow-sm border border-brand-100">
          <span class="flex text-accent-400 text-sm"><Icon name="fa6-solid:star" /><Icon name="fa6-solid:star" /><Icon name="fa6-solid:star" /><Icon name="fa6-solid:star" /><Icon name="fa6-solid:star" /></span>
          <span class="text-brand-900 font-bold text-sm">Clientes satisfechos en cada mudanza</span>
        </div>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        {homeReviews.map((t) => (
          <div class="bg-white p-8 rounded-3xl shadow-sm border border-brand-100 relative flex flex-col">
            <Icon name="fa6-solid:quote-right" class="absolute top-8 right-8 text-4xl text-brand-50" />
            <div class="flex text-accent-400 text-sm mb-4">{Array.from({ length: t.rating }).map(() => <Icon name="fa6-solid:star" />)}</div>
            <h4 class="font-bold text-brand-900 mb-2">{t.title}</h4>
            <p class="text-brand-600 italic mb-6 text-sm leading-relaxed flex-1">“{t.quote}”</p>
            <div class="flex items-center gap-4 border-t border-brand-100 pt-5">
              <div class="w-12 h-12 bg-brand-900 rounded-full flex items-center justify-center font-bold text-accent-400">{t.author.charAt(0)}</div>
              <div><h5 class="font-bold text-brand-900">{t.author}</h5><p class="text-xs text-brand-400">{t.context}</p></div>
            </div>
          </div>
        ))}
      </div>
      <div class="text-center mt-10"><a href="/es/testimonios/" class="inline-flex items-center gap-2 text-accent-600 font-bold hover:text-accent-700">Ver todas las reseñas <Icon name="fa6-solid:arrow-right" /></a></div>
    </div>
  </section>

  <!-- RECURSOS / GUÍAS -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row justify-between items-end mb-14 gap-6">
        <div class="max-w-2xl">
          <div class="flex items-center gap-3 mb-4"><div class="h-px w-12 bg-accent-600"></div><h2 class="text-sm font-bold text-accent-600 uppercase tracking-widest">Recursos</h2></div>
          <h3 class="text-4xl md:text-5xl font-black text-brand-900">Planifique su mudanza como un experto</h3>
        </div>
        <a href="/es/blog/" class="hidden md:inline-flex items-center gap-2 text-brand-600 font-bold hover:text-accent-600 transition-colors shrink-0">Ver el blog <Icon name="fa6-solid:arrow-right-long" /></a>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        <a href="/es/recursos/guia-mudanza-internacional/" class="group bg-brand-50 p-8 rounded-3xl border border-brand-100 hover:shadow-xl hover:border-accent-500 transition-all">
          <div class="w-14 h-14 rounded-2xl bg-brand-900 text-accent-400 flex items-center justify-center text-2xl mb-5 group-hover:bg-accent-500 group-hover:text-white transition-colors"><Icon name="fa6-solid:book" /></div>
          <h4 class="text-xl font-black text-brand-900 mb-2 group-hover:text-accent-600 transition-colors">Guía Definitiva de Mudanzas</h4>
          <p class="text-brand-500 text-sm">Los 8 pasos para mudarse al extranjero sin sorpresas.</p>
        </a>
