---
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { wa } from '../../../data/site';
import { breadcrumb } from '@movers/core/schema';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const fmt = (d: Date) => d.toLocaleDateString('es-PA', { year: 'numeric', month: 'long', day: 'numeric' });

const crumbs = breadcrumb([
  { name: 'Inicio', url: 'https://panamainternationalmovers.com/es/' },
  { name: 'Blog', url: 'https://panamainternationalmovers.com/es/blog/' },
]);
---

<Base
  title="Blog de Mudanzas Internacionales | Consejos y Guías | PIM"
  description="Consejos de empaque, guías de aduanas, vida expatriada y traslado de mascotas. El blog de Panamá International Movers para que tu mudanza sea un éxito."
  lang="es"
  altPaths={{ es: '/es/blog/', en: '/en/blog/' }}
  jsonld={crumbs}
>
  <Header locale="es" />

  <section class="relative pt-40 pb-20 bg-brand-900 overflow-hidden">
    <div class="absolute inset-0" style="background:linear-gradient(180deg, rgba(10,25,47,0.9), rgba(10,25,47,0.98));"></div>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <nav class="text-sm text-brand-300 mb-6 flex justify-center gap-2"><a href="/es/" class="hover:text-accent-400">Inicio</a><span>/</span><span class="text-accent-400">Blog</span></nav>
      <h1 class="text-4xl md:text-6xl font-black text-white mb-6">Consejos para una <span class="text-accent-500">mudanza perfecta</span></h1>
      <p class="text-lg text-brand-200 max-w-2xl mx-auto">Guías prácticas, trucos de empaque, información de aduanas y todo lo que necesita saber para mudarse al extranjero con tranquilidad.</p>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => (
          <a href={`/es/blog/${post.id}/`} class="group bg-brand-50 rounded-3xl overflow-hidden border border-brand-100 hover:shadow-2xl transition-all flex flex-col">
            <div class="h-52 overflow-hidden">
              <img src={post.data.heroImage} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            </div>
            <div class="p-7 flex flex-col flex-1">
              <span class="text-xs font-bold text-accent-600 uppercase tracking-widest mb-3">{post.data.category}</span>
              <h2 class="text-xl font-black text-brand-900 mb-3 leading-tight group-hover:text-accent-600 transition-colors">{post.data.title}</h2>
              <p class="text-brand-500 text-sm leading-relaxed mb-5 flex-1">{post.data.description}</p>
              <div class="flex items-center justify-between text-xs text-brand-400 border-t border-brand-100 pt-4">
                <span>{fmt(post.data.pubDate)}</span>
                <span class="text-accent-600 font-bold flex items-center gap-1">Leer <Icon name="fa6-solid:arrow-right" class="text-[10px] group-hover:translate-x-1 transition-transform" /></span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer locale="es" />
  <a href={wa()} target="_blank" rel="noopener" class="fixed bottom-6 right-6 z-50 w-14 h-14 rounded-full bg-green-500 grid place-items-center shadow-lg" aria-label="WhatsApp"><Icon name="fa6-brands:whatsapp" class="text-white text-3xl" /></a>
</Base>
