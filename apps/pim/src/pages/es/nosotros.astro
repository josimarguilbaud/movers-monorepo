---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { Icon } from 'astro-icon/components';
import { site, wa, yearsInBusiness } from '../../data/site';
import { imgFor } from '../../data/images';
import { breadcrumb, faqPage } from '@movers/core/schema';
import { inline, plain } from '@movers/core/text';

const crumbs = breadcrumb([
  { name: 'Inicio', url: 'https://panamainternationalmovers.com/es/' },
  { name: 'Nosotros', url: 'https://panamainternationalmovers.com/es/nosotros/' },
]);

const values = [
  { icon: 'fa6-solid:handshake', title: 'Trato familiar', text: 'Atención directa y personal de quienes conocen su caso. Aquí usted es una familia, no un número.' },
  { icon: 'fa6-solid:shield-halved', title: 'Responsabilidad', text: 'Cuidamos su patrimonio como si fuera nuestro, con embalaje profesional y seguro a todo riesgo.' },
  { icon: 'fa6-solid:earth-americas', title: 'Estándar global', text: 'Una red de agentes en los cinco continentes para garantizar excelencia también en el destino.' },
  { icon: 'fa6-solid:heart', title: 'Cercanía', text: 'Un coordinador personal lo acompaña de principio a fin, resolviendo cada duda con transparencia.' },
];

const stats = [
  { value: `${yearsInBusiness}+`, label: 'Años de experiencia' },
  { value: 'Global', label: 'Cobertura mundial' },
  { value: '1990', label: 'Año de fundación' },
  { value: '100%', label: 'Compromiso familiar' },
];

/* Las cuatro etapas son las mismas que describe la home y las fichas de
   servicio: es el proceso que el sitio ya publica, no uno nuevo. */
const process = [
  { n: '01', icon: 'fa6-solid:clipboard-list', title: 'Inspección y asesoría', text: 'Vemos el volumen real en su casa u oficina, o por videollamada si prefiere. De ahí sale la cotización, no de una estimación por teléfono.' },
  { n: '02', icon: 'fa6-solid:box', title: 'Embalaje e inventario', text: 'Empacamos con material de exportación y anotamos cada bulto. Ese inventario es después la base del despacho aduanero y del seguro.' },
  { n: '03', icon: 'fa6-solid:ship', title: 'Tránsito y aduanas', text: 'Coordinamos el transporte y la documentación en origen y en destino. La parte donde una mudanza se atasca semanas si se hace mal.' },
  { n: '04', icon: 'fa6-solid:house-chimney-window', title: 'Entrega e instalación', text: 'Descargamos, desembalamos, colocamos donde nos diga y nos llevamos el material de embalaje. No dejamos una montaña de cartón.' },
];

/* Corredores destacados. Los slugs salen de destinations.ts: si se renombra
   alguno, hay que actualizarlo aquí. */
const corridors = [
  { slug: 'mudanzas-de-panama-a-espana', flag: '🇪🇸', name: 'España' },
  { slug: 'mudanzas-de-panama-a-estados-unidos', flag: '🇺🇸', name: 'Estados Unidos' },
  { slug: 'mudanzas-de-panama-a-canada', flag: '🇨🇦', name: 'Canadá' },
  { slug: 'mudanzas-de-panama-a-mexico', flag: '🇲🇽', name: 'México' },
  { slug: 'mudanzas-de-panama-a-reino-unido', flag: '🇬🇧', name: 'Reino Unido' },
  { slug: 'mudanzas-de-panama-a-colombia', flag: '🇨🇴', name: 'Colombia' },
];

/* Solo compromisos que el sitio ya hace en otras páginas. Nada nuevo. */
const promises = [
  'La **evaluación es gratuita** y no compromete a nada.',
  'La cotización llega **en menos de 24 horas** después de ver el volumen.',
  'Un **coordinador personal** lleva su caso de principio a fin.',
  'Nos encargamos de la **gestión aduanera** en origen y en destino.',
  'Todo lo que se empaca queda **inventariado y etiquetado**.',
  'En destino **desembalamos y retiramos el material** de embalaje.',
];

const limits = [
  'No cotizamos **por teléfono sin ver el volumen**. Un precio dado a ciegas termina en cargos extra el día de la carga.',
  'Los tiempos de tránsito son **estimados del sector, no fechas garantizadas**: dependen de la naviera, la ruta y la aduana de destino.',
  'No damos **asesoría legal ni migratoria**. Le decimos qué pide la aduana; su visa la tramita usted o su abogado.',
  'No transportamos **artículos prohibidos**: inflamables, perecederos, plantas, armas ni efectivo.',
  'No prometemos que **quepa todo**. A veces la recomendación honesta es dejar o vender parte.',
];

const faqs = [
  { q: '¿Trabajan solo con mudanzas internacionales?', a: 'No. Movemos también dentro de Ciudad de Panamá y hacia el interior del país, y hacemos traslados de oficinas y empresas. Puede ver el catálogo completo en [servicios](/es/servicios/).' },
  { q: '¿Puedo contratar solo una parte del servicio?', a: 'Sí. Hay quien quiere el paquete completo puerta a puerta y quien solo necesita el [embalaje profesional](/es/servicios/servicio-de-embalaje-profesional/) o el [trámite aduanero](/es/servicios/gestion-aduanera-desaduanizacion/). Se cotiza por separado.' },
  { q: '¿Con cuánta anticipación debo contactarlos?', a: 'Entre cuatro y seis semanas antes de la fecha deseada es lo cómodo: da tiempo a coordinar la inspección, tramitar el seguro y reservar espacio con buenas tarifas. Si su plazo es más corto, avísenos igual y le decimos con franqueza qué es posible.' },
  { q: '¿Qué pasa si cambio la fecha después de contratar?', a: 'Se reprograma. Conviene avisar cuanto antes, porque el espacio en naviera o aerolínea se reserva con anticipación y mover la fecha puede cambiar la ruta disponible.' },
  { q: '¿Atienden a empresas?', a: 'Sí. Las [mudanzas corporativas](/es/servicios/mudanzas-corporativas-de-oficinas/) se planifican por fases para que el corte de operación sea el menor posible, normalmente cargando en fin de semana.' },
  { q: '¿Puedo mover mi carro y mi mascota en la misma mudanza?', a: 'Sí, y es lo habitual. El [transporte de vehículos](/es/servicios/envio-de-autos-en-contenedor/) y el [traslado de mascotas](/es/servicios/transporte-de-mascotas-internacional/) se coordinan junto al resto para que no tenga que cuadrar fechas con varios proveedores.' },
];
---

<Base
  title="Nosotros | Panamá International Movers S.A. — Desde 1990"
  description={`Conozca a Panamá International Movers: empresa familiar panameña fundada en ${site.foundingYear}, con más de ${yearsInBusiness} años moviendo hogares por el mundo. Nuestra historia, valores y compromiso.`}
  lang="es"
  altPaths={{ es: '/es/nosotros/', en: '/en/about/' }}
  jsonld={[crumbs, faqPage(faqs.map((f) => ({ question: plain(f.q), answer: plain(f.a) })))]}
>
  <Header locale="es" />

  <!-- HERO -->
  <section class="relative pt-40 pb-24 bg-brand-900 overflow-hidden">
    <img src={imgFor('nosotros-hero', 0)} alt="Panamá International Movers" class="absolute inset-0 w-full h-full object-cover opacity-25" />
    <div class="absolute inset-0" style="background:linear-gradient(160deg, rgba(10,25,47,0.92), rgba(10,25,47,0.97));"></div>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <nav class="text-sm text-brand-300 mb-6 flex justify-center gap-2"><a href="/es/" class="hover:text-accent-400">Inicio</a><span>/</span><span class="text-accent-400">Nosotros</span></nav>
      <span class="inline-flex items-center gap-2 text-xs font-bold text-accent-500 uppercase tracking-widest bg-white/10 border border-white/15 rounded-full px-4 py-1.5 mb-6">Empresa familiar desde 1990</span>
      <h1 class="text-4xl md:text-6xl font-black text-white mb-6 leading-tight">Más de {yearsInBusiness} años <span class="text-accent-500">moviendo vidas</span></h1>
      <p class="text-lg text-brand-200 max-w-2xl mx-auto leading-relaxed">Somos la empresa familiar panameña de confianza para mudanzas internacionales. Detrás de cada mudanza hay un hogar, un sueño y una nueva etapa. Ese es nuestro propósito.</p>
    </div>
  </section>

  <!-- HISTORIA -->
  <section class="py-24 bg-white relative overflow-hidden">
    <div class="absolute top-0 right-0 w-1/3 h-full bg-brand-50 transform skew-x-12 translate-x-20 z-0"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class="relative h-[560px]">
          <div class="absolute top-0 left-0 w-4/5 h-4/5 rounded-3xl overflow-hidden shadow-2xl">
            <img src={imgFor('nosotros-1', 5)} alt="Equipo PIM" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="absolute bottom-0 right-0 w-3/5 h-3/5 rounded-3xl overflow-hidden shadow-2xl border-8 border-white">
            <img src={imgFor('nosotros-2', 11)} alt="Logística de mudanzas" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="absolute top-1/2 right-8 -translate-y-1/2 bg-brand-900 text-white rounded-full w-32 h-32 flex flex-col items-center justify-center shadow-xl border-4 border-white z-20">
            <span class="text-sm font-bold text-accent-500 uppercase">Desde</span><span class="text-3xl font-black">1990</span>
          </div>
        </div>
        <div>
          <div class="flex items-center gap-3 mb-4"><div class="h-px w-12 bg-accent-500"></div><h2 class="text-sm font-bold text-accent-600 uppercase tracking-widest">Nuestra Historia</h2></div>
          <h3 class="text-4xl md:text-5xl font-black text-brand-900 mb-6 leading-tight">Una tradición familiar de confianza</h3>
          <p class="text-brand-600 mb-5 text-lg leading-relaxed">Fundada en <strong>1990</strong> con valores familiares y una visión global, <strong>Panamá International Movers S.A.</strong> nació para hacer algo más que transportar muebles: para acompañar a las personas en uno de los momentos más importantes de su vida.</p>
          <p class="text-brand-600 mb-5 leading-relaxed">A lo largo de más de tres décadas nos hemos consolidado como un referente en la logística de mudanzas internacionales en Panamá, evolucionando constantemente para ofrecer los estándares más altos, sin perder nunca el trato cercano y personal que nos define.</p>
          <p class="text-brand-600 leading-relaxed">Aprovechamos la posición de Panamá como hub logístico de las Américas para llevar el hogar de nuestros clientes a cualquier rincón del mundo, con seguridad, planificación y acompañamiento profesional.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- MISIÓN / VISIÓN -->
  <section class="py-20 bg-brand-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-2 gap-8">
      <div class="bg-white rounded-3xl p-10 border border-brand-100 shadow-sm">
        <div class="w-14 h-14 rounded-2xl bg-brand-900 text-accent-400 flex items-center justify-center text-2xl mb-6"><Icon name="fa6-solid:bullseye" /></div>
        <h3 class="text-2xl font-black text-brand-900 mb-3">Nuestra Misión</h3>
        <p class="text-brand-600 leading-relaxed">Hacer que cada mudanza —local o al otro lado del mundo— sea una experiencia segura, fluida y sin estrés, cuidando el patrimonio y la tranquilidad de cada familia y empresa como si fueran propios.</p>
      </div>
      <div class="bg-white rounded-3xl p-10 border border-brand-100 shadow-sm">
        <div class="w-14 h-14 rounded-2xl bg-brand-900 text-accent-400 flex items-center justify-center text-2xl mb-6"><Icon name="fa6-solid:eye" /></div>
        <h3 class="text-2xl font-black text-brand-900 mb-3">Nuestra Visión</h3>
        <p class="text-brand-600 leading-relaxed">Ser la empresa de mudanzas internacionales más confiable de Panamá, reconocida por combinar el estándar global de la industria con la calidez y el compromiso de una empresa familiar.</p>
      </div>
    </div>
  </section>

  <!-- VALORES -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <div class="flex justify-center items-center gap-3 mb-4"><div class="h-px w-12 bg-accent-500"></div><h2 class="text-sm font-bold text-accent-600 uppercase tracking-widest">Lo que nos define</h2><div class="h-px w-12 bg-accent-500"></div></div>
        <h3 class="text-3xl md:text-4xl font-black text-brand-900">Nuestros valores</h3>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {values.map((v) => (
          <div class="bg-brand-50 p-8 rounded-3xl border border-brand-100">
            <div class="w-14 h-14 rounded-2xl bg-white text-accent-600 flex items-center justify-center text-2xl mb-5 shadow-sm"><Icon name={v.icon} /></div>
            <h4 class="text-lg font-bold text-brand-900 mb-2">{v.title}</h4>
            <p class="text-brand-500 text-sm leading-relaxed">{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- STATS -->
  <div class="bg-accent-500">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 grid grid-cols-2 md:grid-cols-4 gap-8 divide-x divide-brand-900/10">
      {stats.map((s) => (
        <div class="text-center"><div class="text-4xl md:text-5xl font-black text-brand-900 mb-2">{s.value}</div><div class="text-sm font-bold uppercase tracking-wider text-brand-800">{s.label}</div></div>
      ))}
    </div>
  </div>

  <!-- CÓMO TRABAJAMOS -->
  <section class="py-24 bg-brand-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <div class="flex justify-center items-center gap-3 mb-4"><div class="h-px w-12 bg-accent-500"></div><h2 class="text-sm font-bold text-accent-600 uppercase tracking-widest">Cómo trabajamos</h2><div class="h-px w-12 bg-accent-500"></div></div>
        <h3 class="text-3xl md:text-4xl font-black text-brand-900 mb-3">De la primera llamada a la última caja</h3>
        <p class="text-brand-500">Cuatro etapas. En cada una sabe quién responde y qué sigue.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {process.map((step) => (
          <div class="bg-white rounded-3xl p-8 border border-brand-100">
            <div class="flex items-center gap-3 mb-5">
              <span class="w-11 h-11 rounded-2xl bg-brand-900 text-accent-400 grid place-items-center text-lg"><Icon name={step.icon} /></span>
              <span class="text-2xl font-black text-brand-200">{step.n}</span>
            </div>
            <h4 class="text-lg font-bold text-brand-900 mb-2">{step.title}</h4>
            <p class="text-brand-500 text-sm leading-relaxed">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- QUÉ SIGNIFICA GLOBAL -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-[1fr_1.1fr] gap-16 items-center">
        <div>
          <div class="flex items-center gap-3 mb-4"><div class="h-px w-12 bg-accent-500"></div><h2 class="text-sm font-bold text-accent-600 uppercase tracking-widest">Nuestra cobertura</h2></div>
          <h3 class="text-3xl md:text-4xl font-black text-brand-900 mb-6 leading-tight">Qué significa, en concreto, que trabajemos global</h3>
          <p class="text-brand-600 mb-5 leading-relaxed">«Cobertura mundial» es fácil de escribir y difícil de sostener. Para nosotros significa una cosa muy específica: que en el país al que usted se muda hay un agente que responde por la entrega, y que ese agente conoce lo que su aduana pide para el menaje usado.</p>
          <p class="text-brand-600 mb-5 leading-relaxed">Sin esa pieza, una mudanza internacional termina en el puerto de destino y el cliente se queda resolviendo solo la parte más incómoda. Por eso el trabajo en destino se coordina desde aquí, no se subcontrata y se olvida.</p>
          <p class="text-brand-600 mb-8 leading-relaxed">Panamá ayuda: el país es punto de conexión marítima entre el Atlántico y el Pacífico, y eso se traduce en más frecuencias y más rutas disponibles que las que tendría una mudadora en un país sin esa posición.</p>
          <a href="/es/destinos/" class="inline-flex items-center gap-2 text-accent-600 font-bold hover:text-accent-500 transition-colors">Ver los 22 destinos que documentamos <Icon name="fa6-solid:arrow-right" class="text-xs" /></a>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
          {corridors.map((c) => (
            <a href={`/es/destinos/${c.slug}/`} class="group bg-brand-50 hover:bg-brand-900 rounded-2xl px-4 py-4 border border-brand-100 transition-colors">
              <span class="block text-2xl mb-1">{c.flag}</span>
              <span class="block text-sm font-bold text-brand-900 group-hover:text-white transition-colors leading-tight">{c.name}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- LO QUE PROMETEMOS Y LO QUE NO -->
  <section class="py-24 bg-brand-900">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <div class="flex justify-center items-center gap-3 mb-4"><div class="h-px w-12 bg-accent-500"></div><h2 class="text-sm font-bold text-accent-500 uppercase tracking-widest">Sin letra pequeña</h2><div class="h-px w-12 bg-accent-500"></div></div>
        <h3 class="text-3xl md:text-4xl font-black text-white mb-3">Lo que sí prometemos, y lo que no</h3>
        <p class="text-brand-300">Preferimos decirlo antes de firmar y no el día de la carga.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white/5 border border-white/10 rounded-3xl p-8">
          <div class="flex items-center gap-3 mb-6">
            <span class="w-10 h-10 rounded-xl bg-accent-500 text-brand-900 grid place-items-center"><Icon name="fa6-solid:check" /></span>
            <h4 class="text-lg font-bold text-white">Esto sí</h4>
          </div>
          <ul class="space-y-4">
            {promises.map((p) => (
              <li class="flex gap-3 text-brand-200 text-sm leading-relaxed">
                <Icon name="fa6-solid:check" class="text-accent-500 mt-1 shrink-0 text-xs" /><span set:html={inline(p)}></span>
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-3xl p-8">
          <div class="flex items-center gap-3 mb-6">
            <span class="w-10 h-10 rounded-xl bg-brand-700 text-brand-300 grid place-items-center"><Icon name="fa6-solid:xmark" /></span>
            <h4 class="text-lg font-bold text-white">Esto no</h4>
          </div>
          <ul class="space-y-4">
            {limits.map((l) => (
              <li class="flex gap-3 text-brand-300 text-sm leading-relaxed">
                <Icon name="fa6-solid:minus" class="text-brand-500 mt-1 shrink-0 text-xs" /><span set:html={inline(l)}></span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- PREGUNTAS SOBRE LA EMPRESA -->
  <section class="py-24 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <div class="flex justify-center items-center gap-3 mb-4"><div class="h-px w-12 bg-accent-500"></div><h2 class="text-sm font-bold text-accent-600 uppercase tracking-widest">Antes de contratar</h2><div class="h-px w-12 bg-accent-500"></div></div>
        <h3 class="text-3xl md:text-4xl font-black text-brand-900">Lo que más nos preguntan</h3>
      </div>
      <div class="divide-y divide-brand-100 border-y border-brand-100">
        {faqs.map((f) => (
          <details class="group py-5">
            <summary class="flex justify-between items-start gap-4 cursor-pointer list-none font-bold text-brand-900">
              {f.q}
              <Icon name="fa6-solid:plus" class="text-accent-500 shrink-0 mt-1 text-sm group-open:rotate-45 transition-transform" />
            </summary>
            <p class="text-brand-600 leading-relaxed mt-3 text-[15px]" set:html={inline(f.a)}></p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-brand-900 text-center">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h3 class="text-3xl md:text-4xl font-black text-white mb-4">¿Listo para mudarse con quienes saben?</h3>
      <p class="text-brand-300 mb-8">Ponga su mudanza en manos de una empresa familiar con más de {yearsInBusiness} años de experiencia.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/es/contacto/" class="bg-accent-500 text-brand-900 px-8 py-4 rounded-tr-2xl rounded-bl-2xl font-bold hover:bg-accent-400 transition-all">Solicitar Cotización</a>
        <a href={wa()} target="_blank" rel="noopener" class="px-8 py-4 rounded-tr-2xl rounded-bl-2xl font-bold text-white border-2 border-white/30 hover:bg-white/10 transition-all flex items-center justify-center gap-2"><Icon name="fa6-brands:whatsapp" class="text-green-400 text-xl" /> WhatsApp</a>
      </div>
    </div>
  </section>

  <Footer locale="es" />
  <a href={wa()} target="_blank" rel="noopener" class="fixed bottom-6 right-6 z-50 w-14 h-14 rounded-full bg-green-500 grid place-items-center shadow-lg" aria-label="WhatsApp"><Icon name="fa6-brands:whatsapp" class="text-white text-3xl" /></a>
</Base>
