---
import { Icon } from 'astro-icon/components';
import { contactForm, crmForm } from '../data/site';

interface Props {
  locale?: 'es' | 'en';
}
const { locale = 'es' } = Astro.props;

const T = {
  es: {
    subject: 'Nueva solicitud de cotización — Panamá International Movers',
    fromName: 'Sitio web PIM',
    name: 'Nombre Completo', namePh: 'Ej. Juan Pérez',
    type: '¿Qué necesita mover?',
    types: ['Mudanza local', 'Mudanza internacional', 'Oficina o empresa', 'Solo un vehículo', 'Solo mi mascota', 'Solo almacenaje'],
    email: 'Correo electrónico', emailPh: 'correo@ejemplo.com',
    /* El volumen es lo único que decide el precio de una mudanza y antes se
       pedía como texto libre dentro de "Detalles". Preguntarlo por recámaras es
       más fácil de contestar y llega como dato utilizable al coordinador. */
    volume: '¿Cuánto hay que mover?',
    volumeHelp: 'Una referencia basta. El volumen exacto sale en la evaluación.',
    volumes: ['Unas pocas cajas', 'Apartamento de 1 recámara', 'Apartamento de 2 recámaras', 'Casa de 3 recámaras', 'Casa de 4 o más', 'Oficina o local', 'Todavía no lo sé'],
    date: '¿Para cuándo?',
    /* Antes era un campo de fecha obligatorio. Quien pide cotización a menudo
       está decidiendo todavía, y exigir un día exacto era fricción de más. */
    dates: ['En las próximas 4 semanas', 'En 1 a 3 meses', 'En 3 a 6 meses', 'Más adelante', 'Todavía no tengo fecha'],
    phone: 'Teléfono (WhatsApp)', phonePh: '+507 0000-0000',
    packing: '¿Necesita servicio de empaque?', yes: 'Sí', no: 'No', maybe: 'No estoy seguro',
    origin: 'Desde', originPh: 'Ej. Ciudad de Panamá, Panamá',
    dest: 'Hacia', destPh: 'Ej. Madrid, España',
    details: 'Algo más que debamos saber', detailsPh: 'Piso sin ascensor, piano, obras de arte, un carro que va con la mudanza, fechas críticas…',
    contactTitle: 'Y por último, ¿a dónde le enviamos la cotización?',
    send: 'Recibir mi cotización gratis', sending: 'Enviando…',
    promise: 'Respuesta en menos de 24 horas. La evaluación es gratis y no compromete a nada.',
    /* Decía "No compartimos sus datos", y no era exacto: el lead pasa por el
       webhook de automatización y por el CRM. No los vendemos, que es lo que de
       verdad le importa a quien lo lee, y eso sí se puede afirmar. */
    consent: 'Al enviar acepta ser contactado por PIM. Nunca vendemos sus datos.',
    okTitle: '¡Solicitud Recibida!',
    okText: 'Gracias por confiar en PIM. Nuestro equipo revisará su solicitud y le contactaremos en menos de 24 horas.',
    another: 'Enviar otra solicitud',
    errConfig: 'El formulario está en configuración. Escríbanos por WhatsApp mientras tanto.',
    errSend: 'No se pudo enviar. Intente de nuevo o escríbanos por WhatsApp.',
    errNet: 'Error de conexión. Intente de nuevo o escríbanos por WhatsApp.',
  },
  en: {
    subject: 'New quote request — Panamá International Movers',
    fromName: 'PIM website',
    name: 'Full Name', namePh: 'e.g. John Smith',
    type: 'What do you need to move?',
    types: ['Local move', 'International move', 'Office or business', 'A vehicle only', 'My pet only', 'Storage only'],
    email: 'Email address', emailPh: 'you@example.com',
    volume: 'How much is there to move?',
    volumeHelp: 'A rough idea is enough. The exact volume comes out of the survey.',
    volumes: ['Just a few boxes', '1-bedroom apartment', '2-bedroom apartment', '3-bedroom house', '4 bedrooms or more', 'Office or commercial space', 'Not sure yet'],
    date: 'When?',
    dates: ['Within the next 4 weeks', 'In 1 to 3 months', 'In 3 to 6 months', 'Further out', 'No date yet'],
    phone: 'Phone (WhatsApp)', phonePh: '+507 0000-0000',
    packing: 'Do you need packing service?', yes: 'Yes', no: 'No', maybe: 'Not sure',
    origin: 'From', originPh: 'e.g. Panama City, Panama',
    dest: 'To', destPh: 'e.g. Madrid, Spain',
    details: 'Anything else we should know', detailsPh: 'No elevator, a piano, artwork, a car travelling with the move, critical dates…',
    contactTitle: 'Last thing: where do we send the quote?',
    send: 'Get my free quote', sending: 'Sending…',
    promise: 'A reply within 24 hours. The survey is free and commits you to nothing.',
    consent: 'By submitting you agree to be contacted by PIM. We never sell your data.',
    okTitle: 'Request Received!',
    okText: 'Thank you for trusting PIM. Our team will review your request and get back to you within 24 hours.',
    another: 'Send another request',
    errConfig: 'The form is being set up. Please reach us on WhatsApp in the meantime.',
    errSend: 'Could not send. Please try again or reach us on WhatsApp.',
    errNet: 'Connection error. Please try again or reach us on WhatsApp.',
  },
}[locale];

const inputCls =
  'w-full px-5 py-4 rounded-xl border border-brand-200 focus:ring-2 focus:ring-accent-500 outline-none transition-all bg-brand-50 focus:bg-white text-brand-900';
const labelCls = 'block text-xs font-bold text-brand-600 uppercase tracking-wide mb-2';
const optCls =
  'block text-center px-4 py-3 rounded-xl border border-brand-200 bg-brand-50 text-brand-700 font-semibold text-sm peer-checked:bg-brand-900 peer-checked:text-white peer-checked:border-brand-900 hover:border-accent-500 transition-all';
---

<div class="quote-form-wrap">
  <form
    id="quote-form"
    data-endpoint={contactForm.leadWebhook}
    data-crm-endpoint={crmForm.clientId && crmForm.secret ? crmForm.endpoint : ''}
    data-crm-client={crmForm.clientId}
    data-crm-secret={crmForm.secret}
    data-crm-form={crmForm.formName}
    data-send={T.send}
    data-err-config={T.errConfig}
    data-err-send={T.errSend}
    data-err-net={T.errNet}
    class="space-y-5"
  >
    <!-- n8n usa esto para responderle al cliente en su idioma. -->
    <input type="hidden" name="lang" value={locale} />
    <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <!-- 1. Qué mueve. Empieza por lo fácil y sin datos personales. -->
    <div>
      <label class={labelCls}>{T.type} <span class="text-accent-500">*</span></label>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
        {T.types.map((label, i) => (
          <label class="cursor-pointer">
            <input type="radio" name="Tipo de Mudanza" value={label} class="peer sr-only" required={i === 0} />
            <span class={optCls}>{label}</span>
          </label>
        ))}
      </div>
    </div>

    <!-- 2. De dónde a dónde -->
    <div class="grid md:grid-cols-2 gap-5">
      <div>
        <label class={labelCls} for="pim-origen">{T.origin} <span class="text-accent-500">*</span></label>
        <input id="pim-origen" name="Origen" type="text" class={inputCls} placeholder={T.originPh} required />
      </div>
      <div>
        <label class={labelCls} for="pim-destino">{T.dest} <span class="text-accent-500">*</span></label>
        <input id="pim-destino" name="Destino" type="text" class={inputCls} placeholder={T.destPh} required />
      </div>
    </div>

    <!-- 3. Volumen y fecha, los dos como opción y no como dato exacto -->
    <div class="grid md:grid-cols-2 gap-5">
      <div>
        <label class={labelCls} for="pim-volumen">{T.volume} <span class="text-accent-500">*</span></label>
        <select id="pim-volumen" name="Volumen" class={inputCls} required>
          <option value="" disabled selected>—</option>
          {T.volumes.map((v) => <option value={v}>{v}</option>)}
        </select>
        <p class="text-[11px] text-brand-400 mt-1.5">{T.volumeHelp}</p>
      </div>
      <div>
        <label class={labelCls} for="pim-fecha">{T.date} <span class="text-accent-500">*</span></label>
        <select id="pim-fecha" name="Fecha aproximada" class={inputCls} required>
          <option value="" disabled selected>—</option>
          {T.dates.map((d) => <option value={d}>{d}</option>)}
        </select>
      </div>
    </div>

    <!-- 4. Empaque -->
    <div>
      <label class={labelCls}>{T.packing}</label>
      <div class="grid grid-cols-3 gap-2.5">
        {[T.yes, T.no, T.maybe].map((label) => (
          <label class="cursor-pointer">
            <input type="radio" name="Servicio de empaque" value={label} class="peer sr-only" />
            <span class={optCls}>{label}</span>
          </label>
        ))}
      </div>
    </div>

    <!-- 5. Lo que no cabe en un campo -->
    <div>
      <label class={labelCls} for="pim-detalles">{T.details}</label>
      <textarea id="pim-detalles" name="Detalles" rows="3" class={`${inputCls} resize-none`} placeholder={T.detailsPh}></textarea>
    </div>

    <!-- 6. Contacto al final: para entonces ya invirtió tiempo en el formulario -->
    <div class="pt-5 border-t border-brand-100">
      <p class="text-sm font-bold text-brand-900 mb-4">{T.contactTitle}</p>
      <div class="space-y-5">
        <div>
          <label class={labelCls} for="pim-nombre">{T.name} <span class="text-accent-500">*</span></label>
          <input id="pim-nombre" name="Nombre" type="text" class={inputCls} placeholder={T.namePh} required />
        </div>
        <div class="grid md:grid-cols-2 gap-5">
          <div>
            <label class={labelCls} for="pim-email">{T.email} <span class="text-accent-500">*</span></label>
            <input id="pim-email" name="email" type="email" class={inputCls} placeholder={T.emailPh} required />
          </div>
          <div>
            <label class={labelCls} for="pim-tel">{T.phone} <span class="text-accent-500">*</span></label>
            <input id="pim-tel" name="Teléfono" type="tel" class={inputCls} placeholder={T.phonePh} required />
          </div>
        </div>
      </div>
    </div>

    <button type="submit" id="quote-submit" class="w-full bg-accent-500 text-brand-900 font-bold py-4 rounded-xl shadow-lg hover:bg-accent-400 transition-colors flex justify-center items-center gap-2 mt-2 text-lg disabled:opacity-70">
      {T.send} <Icon name="fa6-solid:paper-plane" />
    </button>
    <p id="form-error" class="hidden text-sm text-red-600 text-center"></p>
    <p class="text-xs text-brand-500 text-center font-medium">{T.promise}</p>
    <p class="text-[11px] text-brand-400 text-center">{T.consent}</p>
  </form>

  <div id="form-success" class="hidden text-center py-16">
    <div class="w-20 h-20 bg-green-50 rounded-full flex items-center justify-center text-green-500 text-4xl mx-auto mb-6"><Icon name="fa6-solid:check" /></div>
    <!-- h3 y no h4: el formulario va bajo un h2, y saltar un nivel rompe la
         jerarquía de encabezados que leen los lectores de pantalla y Google. -->
    <h3 class="text-3xl font-black text-brand-900 mb-3">{T.okTitle}</h3>
    <p class="text-brand-600 mb-8 max-w-md mx-auto">{T.okText}</p>
    <button id="reset-form-btn" class="text-accent-600 font-bold hover:text-accent-700 transition-colors">{T.another}</button>
  </div>
</div>

<script>
  const form = document.getElementById('quote-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('form-success');
  const errorMsg = document.getElementById('form-error');
  const submitBtn = document.getElementById('quote-submit') as HTMLButtonElement | null;
  const resetBtn = document.getElementById('reset-form-btn');
  const endpoint = form?.dataset.endpoint || '';
  const sendLabel = form?.dataset.send || 'Enviar';
  const msgConfig = form?.dataset.errConfig || '';
  const msgSend = form?.dataset.errSend || '';
  const msgNet = form?.dataset.errNet || '';

  const showError = (msg: string) => { if (errorMsg) { errorMsg.textContent = msg; errorMsg.classList.remove('hidden'); } };

  /**
   * El mismo lead, además, al CRM — para que el bot de WhatsApp reconozca después
   * a esta persona y NO le vuelva a pedir lo que acaba de escribir aquí.
   *
   * Va aparte del envío a n8n y no se espera: si el CRM está caído o mal
   * configurado, René recibe su correo igual y la persona ve su "solicitud
   * recibida" igual. Esto nunca puede romper el formulario.
   *
   * Los campos se mandan uno por uno a propósito, no volcando el formulario
   * entero: así el honeypot (`botcheck`) y los campos internos del correo no
   * terminan como datos del cliente en el CRM.
   */
  const avisarAlCrm = (fd: FormData) => {
    const crmEndpoint = form?.dataset.crmEndpoint || '';
    if (!crmEndpoint) return; // sin configurar todavía: no se hace nada
    const v = (k: string) => String(fd.get(k) ?? '').trim();
    fetch(crmEndpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        clientId: form?.dataset.crmClient,
        secret: form?.dataset.crmSecret,
        formulario: form?.dataset.crmForm,
        nombre: v('Nombre'),
        email: v('email'),
        telefono: v('Teléfono'),
        mensaje: v('Detalles'),
        // Lo que el bot necesita para no repetir preguntas. Las claves se leen
        // tal cual en su ficha, así que van en español y como las diría una persona.
        'Tipo de mudanza': v('Tipo de Mudanza'),
        Origen: v('Origen'),
        Destino: v('Destino'),
        'Fecha aproximada': v('Fecha aproximada'),
        Embalaje: v('Servicio de empaque'),
      }),
    }).catch(() => { /* el CRM nunca bloquea el formulario */ });
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg?.classList.add('hidden');

    if (!endpoint) {
      showError(msgConfig);
      return;
    }
    if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = '…'; }

    try {
      // urlencoded = "simple request": el navegador no manda preflight CORS.
      const datos = new FormData(form);
      avisarAlCrm(datos);
      const body = new URLSearchParams(datos as any).toString();
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body,
      });
      let ok = res.ok;
      try { const j = await res.json(); ok = ok && (j.success !== false); } catch {}
      if (ok) {
        form.classList.add('hidden');
        successMsg?.classList.remove('hidden');
      } else {
        showError(msgSend);
      }
    } catch {
      showError(msgNet);
    } finally {
      if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = sendLabel; }
    }
  });

  resetBtn?.addEventListener('click', () => {
    form?.reset();
    successMsg?.classList.add('hidden');
    form?.classList.remove('hidden');
  });
</script>
